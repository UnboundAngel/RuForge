{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RuForge",
  "version": "0.8.0",
  "identifier": "com.attic.ruforge",
  "build": {
    "beforeDevCommand": "node scripts/dev-vite.mjs",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "RuForge",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 580,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "dragDropEnabled": false,
        "windowClassname": "RuForge_Chrome_WidgetWin"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost https: data: blob:",
        "media-src": "'self' asset: http://asset.localhost https: data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost https://api.github.com https://api.iconify.design https://api.simplesvg.com https://api.unisvg.com",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "/home/**",
          "/media/**",
          "/mnt/**",
          "C:/**",
          "D:/**",
          "E:/**",
          "F:/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "publisher": "UnboundAngel",
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "resources": {
      "licenses/*": "licenses/",
      "../LICENSE": "licenses/RUFORGE-LICENSE.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "compression": "lzma",
        "displayLanguageSelector": false,
        "languages": ["English"],
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ruforge"]
      }
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://ruforge.app/updater.json",
        "https://raw.githubusercontent.com/UnboundAngel/RuForge/main/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2ODA3MjYzQ0RFRjUwMTIKUldRU1VPL05ZM0tBWmhBSFpNcEQvQXBKMVhOYXZuNXU2U2hBUFhSMjlCSXJneUVUMDZOY0JDNWoK"
    }
  }
}
