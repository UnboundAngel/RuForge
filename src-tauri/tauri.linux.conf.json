{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "/home/**",
          "/media/**",
          "/run/media/**",
          "/mnt/**"
        ]
      }
    }
  },
  "bundle": {
    "targets": ["deb", "appimage"]
  }
}
