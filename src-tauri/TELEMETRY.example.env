# Copy to src-tauri/.env (gitignored) before a signed build with telemetry enabled.
# These are compile-time inputs via option_env! in lib.rs; export them when running cargo build
# or place them in .env and load through your build environment.

# Aptabase app key (self-hosted region uses A-SH-<id> format)
APTABASE_APP_KEY=

# Self-hosted Aptabase ingest host (required when app key region is SH), e.g. https://aptabase.example.com
APTABASE_HOST=

# GlitchTip DSN for crash reports (commit 7+, Sentry SDK)
GLITCHTIP_DSN=
