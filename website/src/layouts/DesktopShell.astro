---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
  flushTop?: boolean;
  jsonLd?: object | object[];
}

const { title, description, flushTop, jsonLd } = Astro.props;
---

<BaseLayout title={title} description={description} flushTop={flushTop} jsonLd={jsonLd}>
  <slot />
</BaseLayout>
