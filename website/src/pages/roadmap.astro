---
import BaseLayout from '../layouts/BaseLayout.astro';
import RoadmapFieldNotes from '../components/RoadmapFieldNotes';
import InkStamp from '../components/InkStamp.astro';
import { SITE } from '../lib/site';
import {
  loadRoadmapEntries,
  priorityArcDasharray,
  priorityLabel,
  transformRoadmapItems,
} from '../lib/roadmapFieldNotes';
import { readNextVersion } from '../lib/roadmapNextVersion';

const items = transformRoadmapItems(loadRoadmapEntries());
const nextVersion = readNextVersion();
const building = items.filter((item) => item.status === 'progress');
const readyCount = items.filter((item) => item.status === 'unreleased').length;
---

<BaseLayout
  title="RuForge roadmap"
  description="Public feature roadmap. What is shipped, what is in progress, and what is on the horizon."
  flushTop
>
  <div class="rf-roadmap-ambient" aria-hidden="true">
    <div class="rf-roadmap-glow rf-roadmap-glow--1"></div>
    <div class="rf-roadmap-glow rf-roadmap-glow--2"></div>
  </div>

  <section class="rf-roadmap-hero">
    <div class="rf-roadmap-hero-inner">
      <h1 class="rf-roadmap-hero-title">
        <span class="rf-roadmap-hero-line">what's coming</span>
        <span class="rf-roadmap-hero-hand">
          next
          <svg
            class="rf-roadmap-squiggle rf-roadmap-squiggle--hero"
            viewBox="0 0 200 16"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <path
              d="M 0,8 Q 50,0 100,8 Q 150,16 200,8"
              stroke="currentColor"
              stroke-width="2"
              fill="none"
              stroke-linecap="round"
              pathLength="230"
              class="rf-roadmap-draw-line rf-roadmap-draw-line--hero"
            ></path>
          </svg>
        </span>
      </h1>
      <p class="rf-roadmap-hero-copy">
        everything RuForge has shipped, what's being built now, and what comes after that
      </p>
    </div>

    {building.length > 0 && (
      <aside class="rf-roadmap-now" aria-labelledby="roadmap-now-label">
        <div class="rf-roadmap-now-stamp">
          <InkStamp id="roadmap-now-stamp" top="work in progress" bottom="open source" />
        </div>
        <p id="roadmap-now-label" class="rf-roadmap-now-label">being built right now</p>
        <ul class="rf-roadmap-now-list">
          {building.map((item) => (
            <li class="rf-roadmap-now-item">
              <span
                class={`rf-roadmap-priority-trig rf-roadmap-priority-trig--${item.priority} rf-roadmap-priority-trig--lead`}
                tabindex="0"
                role="img"
                aria-label={`Priority: ${priorityLabel(item.priority)}`}
              >
                <svg width="20" height="20" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <circle class="rf-roadmap-priority-track" cx="8" cy="8" r="5.5" stroke="currentColor" stroke-width="2" />
                  <circle
                    class="rf-roadmap-priority-arc"
                    cx="8"
                    cy="8"
                    r="5.5"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-dasharray={priorityArcDasharray(item.priority)}
                    stroke-dashoffset="-8.6"
                    stroke-linecap="round"
                  />
                </svg>
                <span class="rf-roadmap-priority-tt" role="tooltip">{priorityLabel(item.priority)} priority</span>
              </span>
              <span class="rf-roadmap-now-body">
                <span class="rf-roadmap-now-title">{item.title}</span>
                <span class="rf-roadmap-now-area">{item.area}</span>
              </span>
            </li>
          ))}
        </ul>
        {readyCount > 0 && (
          <a href="#roadmap-ready" class="rf-roadmap-now-next no-underline">
            <span>{readyCount} more {readyCount === 1 ? 'is' : 'are'} finished and coming{nextVersion ? ` in v${nextVersion}` : ' next'}</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 5v14M19 12l-7 7-7-7"></path>
            </svg>
          </a>
        )}
      </aside>
    )}
  </section>

  <RoadmapFieldNotes client:load items={items} nextVersion={nextVersion} hideProgress={building.length > 0} suggestHref={SITE.discussions} />
</BaseLayout>
