---
import BaseLayout from '../layouts/BaseLayout.astro';
import RoadmapFieldNotes from '../components/RoadmapFieldNotes';
import { SITE } from '../lib/site';
import { loadRoadmapEntries, transformRoadmapItems } from '../lib/roadmapFieldNotes';

const items = transformRoadmapItems(loadRoadmapEntries());
---

<BaseLayout
  title="RuForge roadmap"
  description="Public feature roadmap. What is shipped, what is in progress, and what is on the horizon."
>
  <div class="rf-roadmap-ambient" aria-hidden="true">
    <div class="rf-roadmap-glow rf-roadmap-glow--1"></div>
    <div class="rf-roadmap-glow rf-roadmap-glow--2"></div>
  </div>

  <section class="rf-roadmap-hero">
    <div class="rf-roadmap-hero-inner">
      <span class="rf-roadmap-page-eyebrow">
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M9 18l-6 3V6l6-3 6 3 6-3v15l-6 3-6-3z"></path>
          <path d="M9 3v15M15 6v15"></path>
        </svg>
        Roadmap
      </span>
      <h1 class="rf-roadmap-hero-title">
        <span class="rf-roadmap-hero-line">What we're building</span>
        <span class="rf-roadmap-hero-hand">
          next.
          <svg
            class="rf-roadmap-squiggle rf-roadmap-squiggle--hero"
            viewBox="0 0 200 16"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <path
              d="M 0,8 Q 50,0 100,8 Q 150,16 200,8"
              stroke="currentColor"
              stroke-width="2"
              fill="none"
              stroke-linecap="round"
              pathLength="230"
              class="rf-roadmap-draw-line rf-roadmap-draw-line--hero"
            ></path>
          </svg>
        </span>
      </h1>
      <p class="rf-roadmap-hero-copy">
        what's shipped, what we're hammering on now, and what's on the horizon. honest list, nothing
        polished.
      </p>
      <a href={SITE.discussions} class="rf-roadmap-ghost-cta no-underline">
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"></path>
        </svg>
        suggest a feature
      </a>
    </div>
  </section>

  <RoadmapFieldNotes client:load items={items} />
</BaseLayout>
