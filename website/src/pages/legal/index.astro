---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { LEGAL_LINKS, SITE } from '../../lib/site';
import { legalDocInfo } from '../../lib/legal';

const docs = LEGAL_LINKS.map((doc) => ({ ...doc, ...legalDocInfo(doc.file) }));
---

<BaseLayout title="RuForge legal: privacy and terms" description="Privacy policy, terms of service, and license information for RuForge open-source.">
  <div class="rf-container space-y-12 pt-12">
    <header class="flex items-end justify-between gap-10">
      <div class="space-y-3">
        <h1 class="font-display text-5xl font-bold tracking-tight text-rf-text">Legal</h1>
        <p class="text-base text-rf-text-muted">The policies that cover the RuForge desktop app.</p>
      </div>
      <p class="max-w-56 text-right text-sm leading-relaxed text-rf-text-muted/75">
        Questions about these documents? <a class="rf-inline-link" href={`${SITE.github}/issues`}>Open an issue on GitHub</a>
      </p>
    </header>

    <ul class="grid grid-cols-1 gap-5 lg:grid-cols-3">
      {
        docs.map((doc) => (
          <li>
            <a
              href={doc.href}
              class="group flex h-full flex-col lg:min-h-60 rounded-xl bg-rf-surface p-6 no-underline transition-colors duration-150 hover:bg-rf-surface-2"
            >
              <span class="text-xs text-rf-text-muted/60">Updated {doc.updated}</span>
              <span class="mt-4 block text-xl font-semibold tracking-tight text-rf-text">{doc.title}</span>
              <span class="mt-2 block text-sm leading-relaxed text-rf-text-muted">{doc.summary}</span>
              <span class="mt-auto flex items-center justify-between pt-6 text-xs text-rf-text-muted/60">
                <span>{doc.minutes} min read</span>
                <span class="text-rf-text-muted/50 transition-transform duration-150 group-hover:translate-x-1 group-hover:text-rf-accent">
                  <Icon name="chevron-right" size={18} />
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
