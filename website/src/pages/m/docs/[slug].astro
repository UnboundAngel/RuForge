---
import MobileShell from '../../../layouts/MobileShell.astro';
import MobileHeader from '../../../components/mobile/MobileHeader';
import MobileFooter from '../../../components/mobile/MobileFooter.astro';
import MobileDocsPage from '../../../components/mobile/MobileDocsPage.astro';
import { getImage } from 'astro:assets';
import ruforgeLogo from '../../../assets/ruforge-logo.png';
import { allDocsSlugs, findDocsPage } from '../../../lib/docsTree';

export function getStaticPaths() {
  return allDocsSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const match = findDocsPage(slug!);

if (!match) {
  return Astro.redirect('/m/docs');
}

const { page } = match;
const logoImage = await getImage({ src: ruforgeLogo, width: 64 });
---

<MobileShell title={page.title} description={page.description}>
  <MobileHeader client:load logoSrc={logoImage.src} />
  <main class="pt-20 pb-12 px-5 min-h-screen">
    <MobileDocsPage page={page} />
  </main>
  <MobileFooter />
</MobileShell>
