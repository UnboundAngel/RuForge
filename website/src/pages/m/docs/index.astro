---
import MobileShell from '../../../layouts/MobileShell.astro';
import MobileHeader from '../../../components/mobile/MobileHeader';
import MobileFooter from '../../../components/mobile/MobileFooter.astro';
import MobilePageHeader from '../../../components/mobile/MobilePageHeader.astro';
import MobileRow from '../../../components/mobile/MobileRow.astro';
import MobileDisclosure from '../../../components/mobile/MobileDisclosure.astro';
import { getImage } from 'astro:assets';
import ruforgeLogo from '../../../assets/ruforge-logo.png';
import { DOCS_TREE } from '../../../lib/docsTree';

const logoImage = await getImage({ src: ruforgeLogo, width: 64 });
---

<MobileShell title="RuForge documentation" description="Getting started, library folders, settings reference, and a glossary for the open-source media library.">
  <MobileHeader client:load logoSrc={logoImage.src} />

  <main class="pt-20 pb-12 px-5 min-h-screen">
    <MobilePageHeader
      title="Docs"
      description="Guides and reference for downloading, playing, and managing your local media library."
    />

    <ul class="space-y-2">
      {DOCS_TREE.map((section) => (
        <li class="rounded-xl bg-rf-surface">
          <MobileDisclosure id={`m-docs-${section.id}`} buttonClass="flex w-full items-center gap-4 px-4 py-4 text-left">
            <span slot="trigger" class="min-w-0 flex-1">
              <span class="block text-base font-semibold text-rf-text">{section.label}</span>
              <span class="mt-1 block text-xs text-rf-text-muted/60">
                {section.pages.length} page{section.pages.length !== 1 ? 's' : ''}
              </span>
            </span>
            <svg slot="trigger" class="shrink-0 text-rf-text-muted/50 transition-transform duration-300 group-aria-expanded:rotate-180 motion-reduce:transition-none" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 9l6 6 6-6" />
            </svg>
            <ul class="mx-4 border-t border-rf-border/30 py-1.5">
              {section.pages.map((page) => (
                <li class="-mx-2">
                  <a
                    href={page.externalHref || `/m/docs/${page.slug}`}
                    class="rf-m-link flex min-h-[40px] items-center justify-between gap-3 rounded-lg px-2 py-2.5 text-[15px] text-rf-text-muted no-underline"
                    target={page.externalHref?.startsWith('http') ? '_blank' : undefined}
                  >
                    {page.title}
                    <svg class="shrink-0 text-rf-text-muted/40" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M9 18l6-6-6-6" />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          </MobileDisclosure>
        </li>
      ))}
    </ul>

    <h2 class="mb-3 mt-10 text-sm font-semibold text-rf-text-muted/70">Under the hood</h2>
    <MobileRow href="/m/docs/built-with" title="Built with" meta="How RuForge uses each tool it is built on" />
  </main>

  <MobileFooter />
</MobileShell>
