---
import MobileShell from '../../../../layouts/MobileShell.astro';
import MobileHeader from '../../../../components/mobile/MobileHeader';
import MobileFooter from '../../../../components/mobile/MobileFooter.astro';
import MobilePageHeader from '../../../../components/mobile/MobilePageHeader.astro';
import MobileRow from '../../../../components/mobile/MobileRow.astro';
import { getImage } from 'astro:assets';
import ruforgeLogo from '../../../../assets/ruforge-logo.png';
import { BUILT_WITH_PAGES, builtWithHref } from '../../../../lib/builtWithPages';
import { stripInlineCode } from '../../../../lib/inlineCode';

const logoImage = await getImage({ src: ruforgeLogo, width: 64 });
---

<MobileShell title="Built with" description="How RuForge uses YouTube, yt-dlp, Tauri, React, and the rest of the stack.">
  <MobileHeader client:load logoSrc={logoImage.src} />

  <main class="pt-20 pb-12 px-5 min-h-screen">
    <MobilePageHeader
      title="Built with"
      description="The tools RuForge is built on, and what each one does in the app."
      backHref="/m/docs"
      backLabel="Docs"
    />

    <ul class="space-y-2">
      {BUILT_WITH_PAGES.map((page) => (
        <li>
          <MobileRow href={`/m${builtWithHref(page.slug)}`} title={page.title} meta={stripInlineCode(page.lead)} />
        </li>
      ))}
    </ul>
  </main>

  <MobileFooter />
</MobileShell>
