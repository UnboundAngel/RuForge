---
import MobileShell from '../../../../layouts/MobileShell.astro';
import MobileHeader from '../../../../components/mobile/MobileHeader';
import MobileFooter from '../../../../components/mobile/MobileFooter.astro';
import { getImage } from 'astro:assets';
import ruforgeLogo from '../../../../assets/ruforge-logo.png';
import { BUILT_WITH_PAGES, builtWithHref } from '../../../../lib/builtWithPages';

const logoImage = await getImage({ src: ruforgeLogo, width: 64 });
---

<MobileShell title="Built with" description="How RuForge uses YouTube, yt-dlp, Tauri, React, and the rest of the stack.">
  <MobileHeader client:load logoSrc={logoImage.src} />

  <main class="pt-20 pb-12 px-5 min-h-screen">
    <div class="mb-6">
      <a href="/m/docs" class="rf-m-btn inline-flex items-center gap-1.5 text-sm text-rf-text-muted no-underline hover:text-rf-text mb-4">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 18l-6-6 6-6" />
        </svg>
        Docs
      </a>
      <h1 class="font-display text-2xl font-bold tracking-tight text-rf-text">
        Built with
      </h1>
      <p class="mt-2 text-sm text-rf-text-muted/80 leading-relaxed">
        How RuForge uses each tool in the stack. Sixteen entries, same as the Docs nav grid.
      </p>
    </div>

    <ul class="space-y-2">
      {BUILT_WITH_PAGES.map((page) => (
        <li>
          <a
            href={`/m${builtWithHref(page.slug)}`}
            class="rf-m-link group flex items-center justify-between gap-3 py-3 px-3 -mx-1 rounded-xl no-underline hover:bg-rf-surface/40"
          >
            <div class="min-w-0">
              <p class="text-[15px] font-semibold text-rf-text group-hover:text-rf-accent transition-colors">
                {page.title}
              </p>
              <p class="text-xs text-rf-text-muted/70 leading-relaxed mt-0.5 line-clamp-2">
                {page.lead}
              </p>
            </div>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-rf-text-muted/40 group-hover:text-rf-accent transition-colors">
              <path d="M9 18l6-6-6-6" />
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </main>

  <MobileFooter />
</MobileShell>
