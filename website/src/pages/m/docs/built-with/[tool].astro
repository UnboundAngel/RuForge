---
import MobileShell from '../../../../layouts/MobileShell.astro';
import MobileHeader from '../../../../components/mobile/MobileHeader';
import MobileFooter from '../../../../components/mobile/MobileFooter.astro';
import InlineCodeText from '../../../../components/InlineCodeText.astro';
import MobilePageHeader from '../../../../components/mobile/MobilePageHeader.astro';
import Disclosure from '../../../../components/Disclosure.astro';
import CodeSnippetPanel from '../../../../components/CodeSnippetPanel';
import { getImage } from 'astro:assets';
import ruforgeLogo from '../../../../assets/ruforge-logo.png';
import {
  findBuiltWithPage,
  getBuiltWithStaticPaths,
  builtWithHref,
} from '../../../../lib/builtWithPages';
import { readCodeSnippet } from '../../../../lib/readCodeSnippet';
import { highlightCode } from '../../../../lib/highlightCode';

export function getStaticPaths() {
  return getBuiltWithStaticPaths().map(({ tool }) => ({
    params: { tool },
  }));
}

const slug = Astro.params.tool!;
const page = findBuiltWithPage(slug);

if (!page) {
  return Astro.redirect('/m/docs/built-with');
}

const logoImage = await getImage({ src: ruforgeLogo, width: 64 });
const [firstParagraph, ...moreParagraphs] = page.paragraphs;

const resolvedSnippets = await Promise.all(
  (page.codeExamples ?? []).map(async (example) => {
    const snippet = readCodeSnippet(example);
    const html = await highlightCode(snippet.code, snippet.language);
    return { ...snippet, html };
  }),
);
---

<MobileShell title={page.title} description={page.lead}>
  <MobileHeader client:load logoSrc={logoImage.src} />

  <main class="pt-20 pb-12 px-5 min-h-screen">
    <MobilePageHeader title={page.title} backHref="/m/docs/built-with" backLabel="Built with">
      <p class="rf-m-read mt-2 text-rf-text-muted/90">
        <InlineCodeText text={page.lead} />
      </p>
    </MobilePageHeader>

    <div class="rf-m-read space-y-4">

      {firstParagraph && (
        <p>
          <InlineCodeText text={firstParagraph} />
        </p>
      )}

      {moreParagraphs.length > 0 && (
        <Disclosure id="m-built-with-more" triggerAfter buttonClass="-mx-2 -mt-2 inline-flex items-center gap-1.5 rounded-lg px-2 py-2 text-[13px] font-medium text-rf-accent">
          <span slot="trigger" data-when-closed>read the technical details</span>
          <span slot="trigger" data-when-open hidden>show less</span>
          <svg slot="trigger" class="transition-transform duration-300 group-aria-expanded:rotate-180 motion-reduce:transition-none" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 9l6 6 6-6" />
          </svg>
          <div class="space-y-4 pb-2">
            {moreParagraphs.map((paragraph) => (
              <p>
                <InlineCodeText text={paragraph} />
              </p>
            ))}
          </div>
        </Disclosure>
      )}

      {resolvedSnippets.length > 0 && (
        <section class="space-y-3 pt-6">
          <h2 class="text-lg font-semibold tracking-tight text-rf-text">In the repo</h2>
          <div class="space-y-3">
            {resolvedSnippets.map((snippet) => (
              <CodeSnippetPanel
                client:visible
                file={snippet.file}
                languageLabel={snippet.languageLabel}
                lineHint={snippet.lineHint}
                caption={snippet.caption}
                html={snippet.html}
              />
            ))}
          </div>
        </section>
      )}

      {page.touchpoints && page.touchpoints.length > 0 && (
        <section class="pt-6">
          <h2 class="mb-3 text-lg font-semibold tracking-tight text-rf-text">Where it shows up</h2>
          <ul class="divide-y divide-rf-border/30">
            {page.touchpoints.map((item) => (
              <li class="py-2.5">
                <InlineCodeText text={item} />
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </main>

  <MobileFooter />
</MobileShell>
