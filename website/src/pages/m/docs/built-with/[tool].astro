---
import MobileShell from '../../../../layouts/MobileShell.astro';
import MobileHeader from '../../../../components/mobile/MobileHeader';
import MobileFooter from '../../../../components/mobile/MobileFooter.astro';
import InlineCodeText from '../../../../components/InlineCodeText.astro';
import CodeSnippetPanel from '../../../../components/CodeSnippetPanel';
import { getImage } from 'astro:assets';
import ruforgeLogo from '../../../../assets/ruforge-logo.png';
import {
  findBuiltWithPage,
  getBuiltWithStaticPaths,
  builtWithHref,
} from '../../../../lib/builtWithPages';
import { readCodeSnippet } from '../../../../lib/readCodeSnippet';
import { highlightCode } from '../../../../lib/highlightCode';

export function getStaticPaths() {
  return getBuiltWithStaticPaths().map(({ tool }) => ({
    params: { tool },
  }));
}

const slug = Astro.params.tool!;
const page = findBuiltWithPage(slug);

if (!page) {
  return Astro.redirect('/m/docs/built-with');
}

const logoImage = await getImage({ src: ruforgeLogo, width: 64 });

const resolvedSnippets = await Promise.all(
  (page.codeExamples ?? []).map(async (example) => {
    const snippet = readCodeSnippet(example);
    const html = await highlightCode(snippet.code, snippet.language);
    return { ...snippet, html };
  }),
);
---

<MobileShell title={page.title} description={page.lead}>
  <MobileHeader client:load logoSrc={logoImage.src} />

  <main class="pt-20 pb-12 px-5 min-h-screen">
    <div class="mb-6">
      <a href="/m/docs/built-with" class="rf-m-btn inline-flex items-center gap-1.5 text-sm text-rf-text-muted no-underline hover:text-rf-text mb-4">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 18l-6-6 6-6" />
        </svg>
        Built with
      </a>

      <h1 class="font-display text-2xl font-bold tracking-tight text-rf-text leading-tight">
        {page.title}
      </h1>
      <p class="mt-2 text-sm text-rf-text-muted/80 leading-relaxed">
        <InlineCodeText text={page.lead} />
      </p>
    </div>

    <div class="space-y-4">
      {page.paragraphs.map((paragraph) => (
        <p class="text-sm leading-relaxed text-rf-text-muted">
          <InlineCodeText text={paragraph} />
        </p>
      ))}

      {resolvedSnippets.length > 0 && (
        <section class="space-y-3">
          <h2 class="text-sm font-semibold text-rf-text">In the repo</h2>
          <div class="space-y-3">
            {resolvedSnippets.map((snippet) => (
              <CodeSnippetPanel
                client:visible
                file={snippet.file}
                languageLabel={snippet.languageLabel}
                lineHint={snippet.lineHint}
                caption={snippet.caption}
                html={snippet.html}
              />
            ))}
          </div>
        </section>
      )}

      {page.touchpoints && page.touchpoints.length > 0 && (
        <section class="rounded-xl border border-rf-border/20 bg-rf-surface/20 px-4 py-4">
          <h2 class="text-sm font-semibold text-rf-text mb-3">Where it shows up</h2>
          <ul class="space-y-2 text-sm text-rf-text-muted">
            {page.touchpoints.map((item) => (
              <li class="flex gap-2">
                <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-rf-accent/60" aria-hidden="true" />
                <span><InlineCodeText text={item} /></span>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </main>

  <MobileFooter />
</MobileShell>
