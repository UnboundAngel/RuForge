---
import MobileShell from '../../layouts/MobileShell.astro';
import MobileHeader from '../../components/mobile/MobileHeader';
import MobileFooter from '../../components/mobile/MobileFooter.astro';
import RoadmapFieldNotes from '../../components/RoadmapFieldNotes';
import { getImage } from 'astro:assets';
import ruforgeLogo from '../../assets/ruforge-logo.png';
import { SITE } from '../../lib/site';
import InkStamp from '../../components/InkStamp.astro';
import {
  loadRoadmapEntries,
  priorityArcDasharray,
  priorityLabel,
  transformRoadmapItems,
} from '../../lib/roadmapFieldNotes';
import { readNextVersion } from '../../lib/roadmapNextVersion';

const logoImage = await getImage({ src: ruforgeLogo, width: 64 });
const items = transformRoadmapItems(loadRoadmapEntries());
const nextVersion = readNextVersion();
const building = items.filter((item) => item.status === 'progress');
const readyCount = items.filter((item) => item.status === 'unreleased').length;
---

<MobileShell
  title="RuForge roadmap"
  description="Public feature roadmap. What is shipped, what is in progress, and what is on the horizon."
>
  <MobileHeader client:load logoSrc={logoImage.src} />

  <main class="rf-roadmap--mobile pt-20 pb-12 min-h-screen">
    <div class="px-5 mb-2">
      <a
        href="/m/"
        class="rf-m-btn inline-flex items-center gap-1.5 text-sm text-rf-text-muted no-underline hover:text-rf-text mb-4"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M15 18l-6-6 6-6"></path>
        </svg>
        back
      </a>
      <h1 class="font-display text-2xl font-bold tracking-tight text-rf-text">what's coming next</h1>
      <p class="mt-2 text-sm text-rf-text-muted/80 leading-relaxed max-w-md">
        everything RuForge has shipped, what's being built now, and what comes after that
      </p>
      <a
        href={SITE.discussions}
        target="_blank"
        rel="noopener noreferrer"
        class="rf-roadmap-cta rf-m-btn no-underline mt-4"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"></path>
        </svg>
        suggest a feature
      </a>

      {building.length > 0 && (
        <aside class="rf-roadmap-now rf-roadmap-now--mobile" aria-labelledby="m-roadmap-now-label">
          <div class="rf-roadmap-now-stamp">
            <InkStamp id="m-roadmap-now-stamp" top="work in progress" bottom="roadmap" />
          </div>
          <p id="m-roadmap-now-label" class="rf-roadmap-now-label">being built right now</p>
          <ul class="rf-roadmap-now-list">
            {building.map((item) => (
              <li class="rf-roadmap-now-item">
                <span class={`rf-roadmap-priority-trig rf-roadmap-priority-trig--${item.priority} rf-roadmap-priority-trig--lead`} aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 16 16" fill="none">
                    <circle class="rf-roadmap-priority-track" cx="8" cy="8" r="5.5" stroke="currentColor" stroke-width="2" />
                    <circle
                      class="rf-roadmap-priority-arc"
                      cx="8"
                      cy="8"
                      r="5.5"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-dasharray={priorityArcDasharray(item.priority)}
                      stroke-dashoffset="-8.6"
                      stroke-linecap="round"
                    />
                  </svg>
                </span>
                <span class="rf-roadmap-now-body">
                  <span class="rf-roadmap-now-title">{item.title}</span>
                  <span class="rf-roadmap-now-area">
                    {item.area}
                    <span class={`rf-roadmap-priority-inline rf-roadmap-priority-inline--${item.priority}`}>
                      · {priorityLabel(item.priority)} priority
                    </span>
                  </span>
                </span>
              </li>
            ))}
          </ul>
          {readyCount > 0 && (
            <a href="#roadmap-ready" class="rf-roadmap-now-next rf-m-btn no-underline">
              <span>{readyCount} more {readyCount === 1 ? 'is' : 'are'} finished and coming{nextVersion ? ` in v${nextVersion}` : ' next'}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 5v14M19 12l-7 7-7-7"></path>
              </svg>
            </a>
          )}
        </aside>
      )}
    </div>

    <RoadmapFieldNotes client:load items={items} nextVersion={nextVersion} touchTooltips hideProgress={building.length > 0} />
  </main>

  <MobileFooter />
</MobileShell>
