---
import MobileShell from '../../../layouts/MobileShell.astro';
import MobileHeader from '../../../components/mobile/MobileHeader';
import MobileFooter from '../../../components/mobile/MobileFooter.astro';
import MobilePageHeader from '../../../components/mobile/MobilePageHeader.astro';
import Disclosure from '../../../components/Disclosure.astro';
import Table from '../../../components/ui/Table.astro';
import { getImage } from 'astro:assets';
import ruforgeLogo from '../../../assets/ruforge-logo.png';
import { FEATURES, FEATURES_TEXT_PATH, FEATURE_HEADERS, featureTableRows, formatUpdated } from '../../../lib/features';

const logoImage = await getImage({ src: ruforgeLogo, width: 64 });
const { areas, version, updated } = FEATURES;
---

<MobileShell title="All RuForge features" description="A quick reference of what RuForge already does, grouped by area.">
  <MobileHeader client:load logoSrc={logoImage.src} />

  <main class="pt-20 pb-12 px-5 min-h-screen">
    <MobilePageHeader title="All features" backHref="/m/features">
      <p class="mt-3 text-xs text-rf-text-muted/60">Updated {formatUpdated(updated)}, v{version}</p>
      <a href={FEATURES_TEXT_PATH} class="rf-m-link mt-3 inline-flex items-center text-sm font-medium text-rf-accent no-underline">
        Plain text version
      </a>
    </MobilePageHeader>

    <ul class="space-y-2">
      {
        areas.map((area) => (
          <li id={area.id} class="rounded-xl bg-rf-surface">
            <Disclosure id={`m-features-${area.id}`} buttonClass="flex w-full items-center gap-4 px-4 py-4 text-left">
              <span slot="trigger" class="min-w-0 flex-1 text-base font-semibold text-rf-text">{area.title}</span>
              <svg slot="trigger" class="shrink-0 text-rf-text-muted/50 transition-transform duration-300 group-aria-expanded:rotate-180 motion-reduce:transition-none" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 9l6 6 6-6" />
              </svg>
              <Table headers={FEATURE_HEADERS} rows={featureTableRows(area)} caption={`${area.title} features`} stack />
            </Disclosure>
          </li>
        ))
      }
    </ul>
  </main>

  <MobileFooter />
</MobileShell>
