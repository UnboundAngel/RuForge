---
import MobileShell from '../../../layouts/MobileShell.astro';
import MobileHeader from '../../../components/mobile/MobileHeader';
import MobileFooter from '../../../components/mobile/MobileFooter.astro';
import { getImage } from 'astro:assets';
import ruforgeLogo from '../../../assets/ruforge-logo.png';
import { FEATURE_PAGES } from '../../../lib/featurePageData';

const logoImage = await getImage({ src: ruforgeLogo, width: 64 });
---

<MobileShell title="Features: RuForge open-source media library" description="What RuForge ships today: persistent download queue, audio-only mode, chapter scrubber, SponsorBlock, mini player.">
  <MobileHeader client:load logoSrc={logoImage.src} />

  <main class="pt-20 pb-12 px-5 min-h-screen">
    <div class="mb-8 text-center">
      <h1 class="font-display text-2xl font-bold tracking-tight text-rf-text leading-tight">
        Everything you need. Offline.
      </h1>
      <p class="mt-2 text-sm text-rf-text-muted/80 leading-relaxed max-w-xs mx-auto">
        A fully integrated workflow engine that indexes your catalog on disk and protects your online data footprint.
      </p>
    </div>

    <ul class="space-y-3">
      {FEATURE_PAGES.map((feature) => (
        <li>
          <a
            href={`/m/features/${feature.slug}`}
            class="rf-m-card group flex flex-col gap-2 px-4 py-4 rounded-xl border border-rf-border/20 bg-rf-surface/20 no-underline hover:border-rf-accent/20"
          >
            <p class="text-[15px] font-semibold text-rf-text group-hover:text-rf-accent transition-colors">
              {feature.title}
            </p>
            <p class="text-xs text-rf-text-muted/70 leading-relaxed line-clamp-2">
              {feature.description}
            </p>
            <p class="text-[10px] text-rf-text-muted/40 font-medium">
              {feature.sections.length} section{feature.sections.length !== 1 ? 's' : ''}
            </p>
          </a>
        </li>
      ))}
    </ul>
  </main>

  <MobileFooter />
</MobileShell>
