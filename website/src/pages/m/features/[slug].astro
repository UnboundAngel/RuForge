---
import { Image } from 'astro:assets';
import MobileShell from '../../../layouts/MobileShell.astro';
import MobileHeader from '../../../components/mobile/MobileHeader';
import MobileFooter from '../../../components/mobile/MobileFooter.astro';
import { getImage } from 'astro:assets';
import ruforgeLogo from '../../../assets/ruforge-logo.png';
import { FEATURE_PAGES, featurePageSlugs, findFeaturePage } from '../../../lib/featurePageData';

export function getStaticPaths() {
  return featurePageSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const page = findFeaturePage(slug!);

if (!page) {
  return Astro.redirect('/m/features');
}

const logoImage = await getImage({ src: ruforgeLogo, width: 64 });

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '../../../assets/tutorials/**/*.png',
  { eager: true },
);

function resolveImage(dir: string, filename: string): ImageMetadata | undefined {
  for (const [path, mod] of Object.entries(allImages)) {
    if (path.includes(`/${dir}/`) && path.endsWith(`/${filename}`)) return mod.default;
  }
  return undefined;
}
---

<MobileShell title={page.metaTitle} description={page.metaDescription}>
  <MobileHeader client:load logoSrc={logoImage.src} />

  <main class="pt-20 pb-12 px-5 min-h-screen">
    <div class="mb-6">
      <a href="/m/features" class="rf-m-btn inline-flex items-center gap-1.5 text-sm text-rf-text-muted no-underline hover:text-rf-text mb-4">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 18l-6-6 6-6" />
        </svg>
        Features
      </a>

      <h1 class="font-display text-2xl font-bold tracking-tight text-rf-text leading-tight">
        {page.title}
      </h1>
      <p class="mt-2 text-sm text-rf-text-muted/80 leading-relaxed">
        {page.description}
      </p>
    </div>

    <div class="space-y-8">
      {page.sections.map((section) => {
        const img = resolveImage(page.imageDir, section.imageFile);
        return (
          <section class="space-y-3">
            {img && (
              <Image
                src={img}
                alt={section.imageAlt}
                widths={[360, 480]}
                sizes="100vw"
                class="w-full h-auto rounded-xl border border-rf-border/10"
              />
            )}
            <h2 class="text-lg font-semibold text-rf-text">{section.heading}</h2>
            <p class="text-sm leading-relaxed text-rf-text-muted">
              {section.body}
            </p>
            {section.bullets.length > 0 && (
              <ul class="space-y-1.5 text-sm text-rf-text-muted">
                {section.bullets.map((b) => (
                  <li class="flex gap-2">
                    <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-rf-accent/60" aria-hidden="true" />
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            )}
          </section>
        );
      })}
    </div>
  </main>

  <MobileFooter />
</MobileShell>
