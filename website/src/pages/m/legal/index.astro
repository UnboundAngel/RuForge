---
import MobileShell from '../../../layouts/MobileShell.astro';
import MobileHeader from '../../../components/mobile/MobileHeader';
import MobileFooter from '../../../components/mobile/MobileFooter.astro';
import MobilePageHeader from '../../../components/mobile/MobilePageHeader.astro';
import MobileRow from '../../../components/mobile/MobileRow.astro';
import { getImage } from 'astro:assets';
import ruforgeLogo from '../../../assets/ruforge-logo.png';
import { LEGAL_LINKS, SITE } from '../../../lib/site';
import { legalDocInfo } from '../../../lib/legal';

const logoImage = await getImage({ src: ruforgeLogo, width: 64 });
const docs = LEGAL_LINKS.map((doc) => ({ ...doc, ...legalDocInfo(doc.file) }));
---

<MobileShell title="RuForge legal: privacy and terms" description="Privacy policy, terms of service, and license information for RuForge open-source.">
  <MobileHeader client:load logoSrc={logoImage.src} />

  <main class="pt-20 pb-12 px-5 min-h-screen">
    <MobilePageHeader title="Legal" description="The policies that cover the RuForge desktop app." />

    <ul class="space-y-2">
      {docs.map((doc) => (
        <li>
          <MobileRow href={`/m${doc.href}`} title={doc.title} meta={`Updated ${doc.updated} · ${doc.minutes} min read`} />
        </li>
      ))}
    </ul>

    <p class="mt-8 text-sm text-rf-text-muted/75">
      Questions about these documents? <a class="rf-inline-link rf-m-link" href={`${SITE.github}/issues`}>Open an issue on GitHub</a>.
    </p>
  </main>

  <MobileFooter />
</MobileShell>
