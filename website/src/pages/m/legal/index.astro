---
import MobileShell from '../../../layouts/MobileShell.astro';
import MobileHeader from '../../../components/mobile/MobileHeader';
import MobileFooter from '../../../components/mobile/MobileFooter.astro';
import { getImage } from 'astro:assets';
import ruforgeLogo from '../../../assets/ruforge-logo.png';
import { LEGAL_LINKS } from '../../../lib/site';

const logoImage = await getImage({ src: ruforgeLogo, width: 64 });

const docMeta: Record<string, { icon: string; blurb: string }> = {
  'Privacy Policy': { icon: '🛡', blurb: 'What RuForge stores locally and what leaves your machine.' },
  'Terms of Use': { icon: '⚖', blurb: 'License, responsibilities, and acceptable use.' },
  'Legal Notice': { icon: '📄', blurb: 'Copyright, disclaimers, and contact.' },
};
---

<MobileShell title="RuForge legal: privacy and terms" description="Privacy policy, terms of service, and license information for RuForge open-source.">
  <MobileHeader client:load logoSrc={logoImage.src} />

  <main class="pt-20 pb-12 px-5 min-h-screen">
    <div class="mb-6">
      <a href="/m/" class="rf-m-btn inline-flex items-center gap-1.5 text-sm text-rf-text-muted no-underline hover:text-rf-text mb-4">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 18l-6-6 6-6" />
        </svg>
        Back
      </a>
      <h1 class="font-display text-2xl font-bold tracking-tight text-rf-text">Legal</h1>
      <p class="mt-2 text-sm text-rf-text-muted/80 leading-relaxed">
        Policies for the RuForge desktop app. Select a document to read the full text.
      </p>
    </div>

    <ul class="space-y-3">
      {LEGAL_LINKS.map((doc) => {
        const meta = docMeta[doc.title];
        return (
          <li>
            <a href={`/m${doc.href}`} class="rf-m-card flex items-center gap-3 px-4 py-4 rounded-xl border border-rf-border/20 bg-rf-surface/20 no-underline hover:border-rf-accent/20">
              <span class="text-xl" aria-hidden="true">{meta.icon}</span>
              <div class="min-w-0">
                <p class="text-[15px] font-semibold text-rf-text">{doc.title}</p>
                <p class="text-xs text-rf-text-muted/70 mt-0.5">{meta.blurb}</p>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </main>

  <MobileFooter />
</MobileShell>
