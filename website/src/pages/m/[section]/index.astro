---
import MobileShell from '../../../layouts/MobileShell.astro';
import MobileHeader from '../../../components/mobile/MobileHeader';
import MobileFooter from '../../../components/mobile/MobileFooter.astro';
import MobileSectionIndex from '../../../components/mobile/MobileSectionIndex.astro';
import { getImage } from 'astro:assets';
import ruforgeLogo from '../../../assets/ruforge-logo.png';
import { NAV_SECTIONS, type NavSectionId } from '../../../lib/sitePages';

export function getStaticPaths() {
  return (['features', 'company', 'resources', 'help'] as const).map((section) => ({
    params: { section },
  }));
}

const sectionId = Astro.params.section as NavSectionId;
const section = NAV_SECTIONS.find((s) => s.id === sectionId)!;
const logoImage = await getImage({ src: ruforgeLogo, width: 64 });
---

<MobileShell title={`${section.label} · RuForge`} description={section.description}>
  <MobileHeader client:load logoSrc={logoImage.src} />
  <main class="pt-20 pb-12 px-5 min-h-screen">
    <MobileSectionIndex section={section} />
  </main>
  <MobileFooter />
</MobileShell>
