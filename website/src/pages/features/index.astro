---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeatureHubsGrid from '../../components/FeatureStackedCards';
import type { FeatureHubEntry } from '../../components/FeatureStackedCards';
import { featureDetailHref } from '../../lib/featurePageData';

const hubs: FeatureHubEntry[] = [
  {
    eyebrow: 'Downloader',
    href: featureDetailHref('downloader'),
    cards: [
      {
        imageSrc: '/tutorials/hub-dl-1.webp',
        title: 'Paste a link',
        description:
          'See the title, length, and file size before you download. Pick video or audio in one click.',
      },
      {
        imageSrc: '/tutorials/hub-dl-2.webp',
        title: 'Whole playlists',
        description:
          'Paste a playlist and choose which videos to keep. Ones you already have are marked.',
      },
      {
        imageSrc: '/tutorials/hub-dl-3.webp',
        title: 'Batches',
        description:
          'Queue many links at once and watch each one finish, with speed and progress on every item.',
      },
    ],
  },
  {
    eyebrow: 'Media Library',
    href: featureDetailHref('media-library'),
    cards: [
      {
        imageSrc: '/tutorials/hub-lib-1.webp',
        title: 'Everything in one place',
        description:
          'Every video you downloaded, sorted and searchable. New downloads show up on their own.',
      },
      {
        imageSrc: '/tutorials/hub-lib-2.webp',
        title: 'Pick up where you left off',
        description:
          'Each card shows how far you got. Continue watching keeps your unfinished videos up front.',
      },
    ],
  },
  {
    eyebrow: 'Video Player',
    href: featureDetailHref('player'),
    cards: [
      {
        imageSrc: '/tutorials/hub-vp-1.webp',
        title: 'Chapter previews',
        description:
          'Hover the bar to see the chapter name and a frame from that moment, then jump straight there.',
      },
      {
        imageSrc: '/tutorials/hub-vp-2.webp',
        title: 'Skip sponsors',
        description:
          'SponsorBlock skips sponsors, intros, and filler for you, or shows a button so you decide.',
      },
      {
        imageSrc: '/tutorials/hub-vp-3.webp',
        title: 'Comments beside the video',
        description:
          'Read the comments without leaving the player. They are saved with the video for later.',
      },
    ],
  },
  {
    eyebrow: 'Music mode',
    href: featureDetailHref('music'),
    cards: [
      {
        imageSrc: '/tutorials/hub-music-1.webp',
        title: 'Your music home',
        description:
          'Quick picks and your artists, built from the songs you already downloaded. Filter by Relax or Focus.',
      },
      {
        imageSrc: '/tutorials/hub-music-2.webp',
        title: 'Lyrics that follow along',
        description:
          'The current line lights up as the song plays, with the cover art and related songs beside it.',
      },
      {
        imageSrc: '/tutorials/hub-music-3.webp',
        title: 'Artist pages',
        description:
          'Every artist gets a page with their albums, genres, and a short bio from MusicBrainz and Wikipedia.',
      },
    ],
  },
  {
    eyebrow: 'Mini Player',
    href: featureDetailHref('mini-player'),
    cards: [
      {
        imageSrc: '/tutorials/hub-mini-1.webp',
        title: 'Keep watching while you work',
        description:
          'A small window that stays on top of your other apps, with the full controls.',
      },
      {
        imageSrc: '/tutorials/hub-mini-2.webp',
        title: 'Any size you want',
        description:
          'Shrink it from a full player down to a thin bar with just play and next.',
      },
    ],
  },
];
---

<BaseLayout title="Features: RuForge open-source media library" description="What RuForge does today: a YouTube downloader, a local library with watch progress, a video player with chapters and SponsorBlock, music mode, and a mini player.">
  <div class="features-index rf-container">
    <header class="features-index__hero">
      <h1 class="features-index__title">Everything you need. Offline.</h1>
      <p class="features-index__desc">
        A free, open-source app for Windows: download from YouTube, keep it all in a local library, and watch with chapters and SponsorBlock.
      </p>
    </header>

    <FeatureHubsGrid client:load hubs={hubs} />
  </div>
</BaseLayout>

<style>
  .features-index {
    max-width: 72rem;
    padding-top: 1rem;
    padding-bottom: 6rem;
  }

  .features-index__hero {
    max-width: 36rem;
    margin-inline: auto;
    margin-bottom: 4.5rem;
    text-align: center;
  }

  .features-index__title {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-rf-text);
  }

  .features-index__desc {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-rf-text-muted);
  }
</style>
