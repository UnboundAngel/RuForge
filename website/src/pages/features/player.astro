---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeaturePageTemplate from '../../components/FeaturePageTemplate.astro';
import { findFeaturePage, featureSectionsWithImages } from '../../lib/featurePageData';

const page = findFeaturePage('player')!;
const sections = await featureSectionsWithImages(page);
---

<BaseLayout title={page.metaTitle} description={page.metaDescription}>
  <FeaturePageTemplate title={page.title} description={page.description} sections={sections} />
</BaseLayout>
