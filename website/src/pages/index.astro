---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import Icon from '../components/Icon.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import MotionDownloadButton from '../components/ui/MotionDownloadButton.astro';
import HeroAnimatedTitle from '../components/HeroAnimatedTitle';
import DownloadTutorialHub from '../components/DownloadTutorialHub.astro';
import FeatureVisualCard from '../components/FeatureVisualCard.astro';
import TechTickerIcon from '../components/TechTickerIcon.astro';
import { techTickerItems } from '../lib/techTickerIcons';
import { Image } from 'astro:assets';
import highlightCoffee from '../assets/highlight-coffee-beans.webp';
import { getCollection } from 'astro:content';
import { SITE } from '../lib/site';

const allReleases = await getCollection('releases');
const latestRelease = allReleases.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
)[0];

const features = [
  {
    title: 'Downloader Screen',
    icon: 'download' as const,
    description: 'Archive videos, playlists, and audio directly. yt-dlp quality selection, browser cookie syncing, and auto-stall watchdog.',
    link: '/roadmap?area=Download+Screen',
    linkText: 'Explore Downloader'
  },
  {
    title: 'Media Library',
    icon: 'list' as const,
    description: 'Auto-scan folders, deduplicate muxed streams, and store local view counters and watch progress privately.',
    link: '/roadmap?area=Video+Library',
    linkText: 'Browse Library Details'
  },
  {
    title: 'Media Player',
    icon: 'play' as const,
    description: 'Hardware-accelerated rendering, keyboard controls, segmented chapter bars, and drag-and-drop subtitle cues.',
    link: '/roadmap?area=Player+Screen',
    linkText: 'Discover Player'
  },
  {
    title: 'SponsorBlock',
    icon: 'star' as const,
    description: 'Skip non-music segments, intros, and sponsor ads on the fly using a privacy-preserving local SHA-256 prefix hash.',
    link: '/roadmap',
    linkText: 'Learn Skip Mechanics'
  },
  {
    title: 'Mini Player',
    icon: 'map' as const,
    description: 'Compact borderless corner player with a visualizer overlay, transparent hover window chrome, and full volume controls.',
    link: '/roadmap',
    linkText: 'Pop Out Mini Details'
  },
  {
    title: 'Advanced Settings',
    icon: 'wrench' as const,
    description: 'Tailor parallel task thresholds, manage download directory scopes, cookies sync keys, and automatic space cleanups.',
    link: '/roadmap?area=Settings+Screen',
    linkText: 'View Settings Architecture'
  }
];
---

<BaseLayout>
  <div class="relative overflow-hidden min-h-screen flex flex-col justify-between">
    {/* Premium Radial Accent Lights */}
    <div class="absolute -top-40 left-1/2 -z-10 h-[600px] w-[1000px] -translate-x-1/2 rounded-full bg-rf-accent/[0.04] blur-[140px] pointer-events-none ambient-glow-1"></div>
    <div class="absolute top-[600px] right-[-100px] -z-10 h-[450px] w-[450px] rounded-full bg-rf-accent/[0.015] blur-[100px] pointer-events-none ambient-glow-2"></div>
    <div class="absolute bottom-40 left-[-200px] -z-10 h-[500px] w-[500px] rounded-full bg-rf-accent/[0.01] blur-[120px] pointer-events-none ambient-glow-3"></div>

    {/* Hero Section */}
    <section class="rf-container pt-16 pb-20 md:pt-24 md:pb-28 text-center relative">
      <div class="max-w-3xl mx-auto space-y-6 md:space-y-8 animate-fade-in">
        <div class="hero-title-wrap">
          <HeroAnimatedTitle client:load lineOne="Your media library," lineTwo="forged locally." />
        </div>

        <p class="hero-subcopy max-w-xl mx-auto text-base sm:text-lg leading-relaxed text-rf-text-muted/90">
          A lightweight, local-first media collector. Streamlined yt-dlp downloading and fine-tuned offline playback with SponsorBlock, chapters, and custom subtitles.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4">
          <a href={SITE.releases} class="rf-btn shadow-lg shadow-rf-accent/5 hover:scale-[1.01]">
            <Icon name="download" size={18} class="text-rf-bg" />
            Download for Windows
          </a>
          <a href={SITE.github} class="rf-btn-ghost">
            <Icon name="github" size={18} />
            GitHub Source
          </a>
          <span class="rf-version rounded-lg bg-rf-surface/60 px-3 py-2 border border-rf-border">v{SITE.latestVersion}</span>
        </div>
      </div>

      {/* 3D Slanted Carousel Container */}
      <div class="mt-20 md:mt-24 max-w-4xl mx-auto animate-slide-up" style="perspective: 2000px;">
        <div 
          class="relative p-1.5 bg-rf-surface/10 rounded-2xl shadow-3xl border border-rf-border/20 overflow-hidden group/carousel carousel-3d-wrapper"
        >
          <HeroCarousel />
          {/* Bottom Gradient Fade to Blend with Background */}
          <div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-[#1D1613] via-[#1D1613]/50 to-transparent pointer-events-none z-10"></div>
        </div>
      </div>
    </section>

    {/* Tech stack ticker */}
    <section class="tech-ticker w-full overflow-hidden py-8 scroll-reveal" aria-label="Built with">
      <div class="tech-ticker__rail relative w-full overflow-hidden">
        <div class="tech-ticker__fade tech-ticker__fade--left" aria-hidden="true"></div>
        <div class="tech-ticker__fade tech-ticker__fade--right" aria-hidden="true"></div>
        <div class="flex gap-6 w-max animate-marquee">
          <div class="tech-ticker__row flex shrink-0 items-center gap-6">
            {
              techTickerItems.map((item) => (
                <div class="tech-ticker__item group flex items-center gap-3 bg-rf-surface/20 hover:bg-rf-surface/35 px-5 py-2.5 rounded-xl border border-rf-border/40 hover:border-rf-border/60 transition-colors duration-300 cursor-default">
                  <span class="tech-ticker__icon-slot flex shrink-0 items-center justify-center">
                    <TechTickerIcon icon={item.icon} />
                  </span>
                  <span class="font-sans text-[11px] font-semibold tracking-[0.16em] uppercase text-rf-text-muted/60 group-hover:text-rf-text-muted transition-colors duration-300">
                    {item.name}
                  </span>
                </div>
              ))
            }
          </div>
          <div class="tech-ticker__row flex shrink-0 items-center gap-6" aria-hidden="true">
            {
              techTickerItems.map((item) => (
                <div class="tech-ticker__item group flex items-center gap-3 bg-rf-surface/20 hover:bg-rf-surface/35 px-5 py-2.5 rounded-xl border border-rf-border/40 hover:border-rf-border/60 transition-colors duration-300 cursor-default">
                  <span class="tech-ticker__icon-slot flex shrink-0 items-center justify-center">
                    <TechTickerIcon icon={item.icon} />
                  </span>
                  <span class="font-sans text-[11px] font-semibold tracking-[0.16em] uppercase text-rf-text-muted/60 group-hover:text-rf-text-muted transition-colors duration-300">
                    {item.name}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    {/* Grid of Interactive Details Cards */}
    <section class="rf-container py-24 md:py-32">
      <div class="text-center max-w-2xl mx-auto mb-16 md:mb-20 space-y-4 scroll-reveal">
        <h2 class="font-display text-3xl font-bold tracking-tight text-rf-text sm:text-4xl">
          Everything you need. Offline.
        </h2>
        <p class="text-base text-rf-text-muted/90">
          A fully integrated workflow engine that indexes your catalog on disk and protects your online data footprint.
        </p>
      </div>

      <DownloadTutorialHub />

      <div class="feature-visual-grid">
        <FeatureVisualCard
          href={features[1].link}
          title={features[1].title}
          description={features[1].description}
          linkText={features[1].linkText}
          icon={features[1].icon}
          tone="feature-visual-card--library"
          delay={0}
        />
        <FeatureVisualCard
          href={features[2].link}
          title={features[2].title}
          description={features[2].description}
          linkText={features[2].linkText}
          icon={features[2].icon}
          tone="feature-visual-card--player"
          delay={80}
        />
        <FeatureVisualCard
          href={features[3].link}
          title={features[3].title}
          description={features[3].description}
          linkText={features[3].linkText}
          icon={features[3].icon}
          tone="feature-visual-card--sponsor"
          delay={160}
        />
        <FeatureVisualCard
          href={features[4].link}
          title={features[4].title}
          description={features[4].description}
          linkText={features[4].linkText}
          icon={features[4].icon}
          tone="feature-visual-card--mini"
          delay={240}
        />
        <FeatureVisualCard
          href={features[5].link}
          title={features[5].title}
          description={features[5].description}
          linkText={features[5].linkText}
          icon={features[5].icon}
          tone="feature-visual-card--settings"
          delay={320}
        />
      </div>
    </section>

    <TestimonialsSection />

    {/* High-Fidelity Rich Highlight Card at Bottom */}
    <section class="rf-container pb-20 md:pb-24 scroll-reveal">
      <div class="highlight-card relative overflow-hidden rounded-3xl p-8 md:p-14 border border-rf-border/40 group/highlight">
        <Image
          src={highlightCoffee}
          alt=""
          class="highlight-card-photo"
          width={1376}
          height={768}
          widths={[768, 1024, 1376]}
          sizes="100vw"
          loading="lazy"
          decoding="async"
        />
        <div class="highlight-card-scrim" aria-hidden="true"></div>

        <div class="relative z-10 flex flex-col">
          <div class="max-w-2xl space-y-6 md:space-y-8">
            <div class="inline-flex items-center gap-2 rounded-full bg-rf-accent/10 px-4 py-1.5 border border-rf-accent/20">
              <Icon name="star" size={14} class="text-rf-accent" />
              <span class="text-xs font-semibold tracking-wider text-rf-accent uppercase">Always-on media freedom</span>
            </div>

            <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-rf-text leading-[1.25]">
              Designed for speed.<br />Engineered for local privacy.
            </h2>

            <p class="text-sm md:text-base leading-relaxed text-rf-text-muted/90">
              RuForge compiles direct Rust bindings with Tauri to deliver near-zero overhead. Your downloads run concurrently, SponsorBlock filters on the fly, and your library indexing is entirely local. No trackers, no accounts, no subscriptions.
            </p>

            <div class="pt-4 flex flex-wrap items-center gap-4">
              <MotionDownloadButton href={SITE.releases} />
              <a href="/roadmap" class="rf-btn-ghost">
                Interactive Roadmap
              </a>
            </div>
          </div>

          {
            latestRelease && (
              <footer class="highlight-card-release mt-8 md:mt-10">
                <div class="flex flex-col gap-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8">
                  <p class="min-w-0 text-sm leading-relaxed text-rf-text-muted/90">
                    <span class="font-semibold text-rf-accent">v{latestRelease.data.version}</span>
                    <span class="text-rf-text-muted/50" aria-hidden="true"> · </span>
                    <span>{latestRelease.data.additions[0]}</span>
                  </p>
                  <a
                    href="/changelog"
                    class="highlight-card-release-link inline-flex items-center gap-1.5 text-sm font-medium text-rf-accent no-underline shrink-0 transition-opacity hover:opacity-90"
                  >
                    View changelog
                    <Icon name="external" size={14} class="opacity-75" />
                  </a>
                </div>
              </footer>
            )
          }
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Tech stack ticker */
  .tech-ticker {
    position: relative;
    isolation: isolate;
  }

  .tech-ticker__icon-slot {
    width: 1rem;
    height: 1rem;
  }

  .tech-ticker__icon-svg {
    display: block;
    width: 1rem;
    height: 1rem;
  }

  .tech-ticker__icon-img {
    display: block;
    width: 1rem;
    height: 1rem;
    object-fit: contain;
    opacity: 0.92;
    transition: opacity 0.3s ease;
  }

  .tech-ticker__item:hover .tech-ticker__icon-img {
    opacity: 1;
  }

  .tech-ticker__icon-slot:has(.tech-ticker__icon-img--wide) {
    width: auto;
    min-width: 1rem;
    max-width: 3.25rem;
  }

  .tech-ticker__icon-img--wide {
    width: auto;
    max-width: 3.25rem;
    height: 1rem;
  }

  .tech-ticker__fade--left,
  .tech-ticker__fade--right {
    position: absolute;
    top: 0;
    bottom: 0;
    width: min(7rem, 16vw);
    z-index: 10;
    pointer-events: none;
  }

  .tech-ticker__fade--left {
    left: 0;
    background: linear-gradient(90deg, #1d1613 20%, transparent);
  }

  .tech-ticker__fade--right {
    right: 0;
    background: linear-gradient(270deg, #1d1613 20%, transparent);
  }

  .tech-ticker:hover .animate-marquee {
    animation-play-state: paused;
  }

  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .animate-marquee {
    animation: marquee 40s linear infinite;
  }

  /* Bottom highlight card: coffee photo background */
  .highlight-card {
    min-height: 18rem;
  }

  .highlight-card-photo,
  .highlight-card-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
  }

  .highlight-card-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      102deg,
      rgb(29 22 19 / 0.9) 0%,
      rgb(29 22 19 / 0.78) 42%,
      rgb(29 22 19 / 0.52) 72%,
      rgb(29 22 19 / 0.38) 100%
    );
    pointer-events: none;
  }

  .highlight-card .rf-btn-ghost {
    background: rgb(29 22 19 / 0.35);
    backdrop-filter: blur(6px);
  }

  .highlight-card-release-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Interactive 3D Perspective Tilt on Screenshot Carousel */
  .carousel-3d-wrapper {
    transform: rotateX(5deg) translateY(-10px);
    transform-style: preserve-3d;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.8s ease, shadow 0.8s ease;
  }

  .carousel-3d-wrapper:hover {
    transform: rotateX(0deg) translateY(0px) scale(1.015);
    border-color: rgba(237, 215, 156, 0.25);
  }

  /* Subtle CSS-only movement for background blurs */
  @keyframes float-glow-1 {
    0% {
      transform: translate(-50%, -40%) scale(1);
      opacity: 0.04;
    }
    50% {
      transform: translate(-47%, -45%) scale(1.1);
      opacity: 0.08;
    }
    100% {
      transform: translate(-50%, -40%) scale(1);
      opacity: 0.04;
    }
  }

  @keyframes float-glow-2 {
    0% {
      transform: translate(0, 0) scale(1);
      opacity: 0.015;
    }
    50% {
      transform: translate(-15px, 25px) scale(1.08);
      opacity: 0.03;
    }
    100% {
      transform: translate(0, 0) scale(1);
      opacity: 0.015;
    }
  }

  @keyframes float-glow-3 {
    0% {
      transform: translate(0, 0) scale(1);
      opacity: 0.01;
    }
    50% {
      transform: translate(20px, -15px) scale(1.05);
      opacity: 0.02;
    }
    100% {
      transform: translate(0, 0) scale(1);
      opacity: 0.01;
    }
  }

  .ambient-glow-1 {
    animation: float-glow-1 15s ease-in-out infinite;
  }

  .ambient-glow-2 {
    animation: float-glow-2 18s ease-in-out infinite;
  }

  .ambient-glow-3 {
    animation: float-glow-3 20s ease-in-out infinite;
  }

  /* Entrance animations */
  .hero-title-wrap {
    margin-bottom: 0.25rem;
  }

  .hero-subcopy {
    margin-top: 0.5rem;
  }

  @media (min-width: 768px) {
    .hero-title-wrap {
      margin-bottom: 0.5rem;
    }

    .hero-subcopy {
      margin-top: 0.75rem;
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .animate-slide-up {
    animation: slideUp 1s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 150ms;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .feature-visual-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .feature-visual-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .feature-visual-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .feature-visual-grid > :nth-child(1) {
      grid-column: span 2;
    }

    .feature-visual-grid > :nth-child(2) {
      grid-column: span 2;
    }

    .feature-visual-grid > :nth-child(3) {
      grid-column: span 2;
    }

    .feature-visual-grid > :nth-child(4) {
      grid-column: 2 / span 2;
    }

    .feature-visual-grid > :nth-child(5) {
      grid-column: 4 / span 2;
    }
  }

  /* Dynamic Interactive Border Spotlight */
  .card-spotlight-border {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: radial-gradient(
      140px circle at var(--mouse-x, 0px) var(--mouse-y, 0px),
      rgba(237, 215, 156, 0.28),
      transparent 80%
    );
    -webkit-mask: 
      linear-gradient(#fff, #fff) content-box, 
      linear-gradient(#fff, #fff);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 5;
  }

  .feature-card:hover .card-spotlight-border {
    opacity: 1;
  }

  /* Staggered Scroll Reveal */
  .scroll-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1), transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
  }

  .scroll-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Custom scrollbar for home page */
  :global(.home-scrollbar) {
    scrollbar-color: rgba(237, 215, 156, 0.2) #1D1613;
    scrollbar-width: thin;
  }

  :global(.home-scrollbar::-webkit-scrollbar) {
    width: 8px;
    height: 8px;
  }

  :global(.home-scrollbar::-webkit-scrollbar-track) {
    background: #1D1613;
  }

  :global(.home-scrollbar::-webkit-scrollbar-thumb) {
    background: rgba(237, 215, 156, 0.2);
    border-radius: 999px;
    border: 2px solid #1D1613;
    transition: background 0.3s ease;
  }

  :global(.home-scrollbar::-webkit-scrollbar-thumb:hover) {
    background: rgba(237, 215, 156, 0.45);
  }
</style>

<script>
  // Add custom scrollbar class specifically for home page
  document.documentElement.classList.add('home-scrollbar');

  // Card spotlight tracking
  function initCardSpotlights() {
    const cards = document.querySelectorAll<HTMLElement>('.feature-card, .spotlight-card');
    cards.forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty('--mouse-x', `${x}px`);
        card.style.setProperty('--mouse-y', `${y}px`);
      });
    });
  }

  // Intersection Observer for scroll-reveal animations
  function initScrollReveal() {
    const observerOptions = {
      root: null,
      rootMargin: '0px 0px -8% 0px',
      threshold: 0.02
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    document.querySelectorAll('.scroll-reveal').forEach((el) => {
      observer.observe(el);
    });
  }

  // Run initializations
  function init() {
    initCardSpotlights();
    initScrollReveal();
  }

  init();
  document.addEventListener('astro:after-swap', init);
</script>
