---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingBackdrop from '../components/LandingBackdrop.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import HeroAnimatedTitle from '../components/HeroAnimatedTitle';
import LandingFeaturesSection from '../components/LandingFeaturesSection.astro';
import TechTickerIcon from '../components/TechTickerIcon.astro';
import Icon from '../components/Icon.astro';
import { techTickerItems } from '../lib/techTickerIcons';
import { Image } from 'astro:assets';
import highlightCoffee from '../assets/highlight-coffee-beans.webp';
import InkStamp from '../components/InkStamp.astro';
import landingGrain from '../assets/landing-grain.webp';
import { softwareApplicationSchema, organizationSchema } from '../lib/structuredData';
import { SITE } from '../lib/site';
import { landingLoginTrust } from '../lib/landingFeatures';

const loginTrust = landingLoginTrust('');
---

<BaseLayout
  title="RuForge: Open-source media library for Windows"
  description={SITE.description}
  flushTop
  jsonLd={[softwareApplicationSchema(), organizationSchema()]}
>
  <div class="relative overflow-hidden min-h-screen flex flex-col justify-between">
    <LandingBackdrop grain={landingGrain} />

    {/* Hero Section */}
    <section class="rf-container pt-36 pb-28 text-center relative">
      <div class="max-w-3xl mx-auto space-y-8 animate-fade-in">
        <div class="hero-title-wrap">
          <HeroAnimatedTitle client:load />
        </div>

        <p class="hero-subcopy max-w-xl mx-auto text-lg leading-relaxed text-rf-text-muted/90">
          a free, open-source Windows app that saves YouTube videos and music to your PC, keeps them in one library, and plays them offline
        </p>

        <div class="flex items-center justify-center gap-3">
          <a href="/download?start=1" class="rf-btn no-underline">
            <Icon name="download" size={16} class="text-rf-bg" />
            <span id="hero-cta-label">Download for Windows</span>
          </a>
          <a href={SITE.github} class="rf-btn-ghost no-underline">
            <Icon name="github" size={16} />
            Source on GitHub
          </a>
        </div>
      </div>

      {/* 3D Slanted Carousel Container */}
      <div class="mt-24 max-w-4xl mx-auto animate-slide-up" style="perspective: 2000px;">
        <div 
          class="relative p-1.5 bg-rf-surface/10 rounded-2xl shadow-3xl border border-rf-border/20 overflow-hidden group/carousel carousel-3d-wrapper"
        >
          <HeroCarousel />
          {/* Bottom Gradient Fade to Blend with Background */}
          <div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-[#1D1613] via-[#1D1613]/50 to-transparent pointer-events-none z-10"></div>
        </div>
      </div>
    </section>

    {/* Tech stack ticker */}
    <section class="tech-ticker w-full overflow-hidden py-8 scroll-reveal" aria-label="Built with">
      <div class="tech-ticker__rail relative w-full overflow-hidden">
        <div class="tech-ticker__marquee flex w-max animate-marquee">
          <div class="tech-ticker__row flex shrink-0 items-center gap-14 pe-14">
            {
              techTickerItems.map((item) => (
                <div class="tech-ticker__item group flex items-center gap-3 py-2.5 cursor-default">
                  <span class="tech-ticker__icon-slot flex shrink-0 items-center justify-center">
                    <TechTickerIcon icon={item.icon} />
                  </span>
                  <span class="font-sans text-[11px] font-semibold tracking-[0.16em] uppercase text-rf-text-muted/60 group-hover:text-rf-text-muted transition-colors duration-300">
                    {item.name}
                  </span>
                </div>
              ))
            }
          </div>
          <div class="tech-ticker__row flex shrink-0 items-center gap-14 pe-14" aria-hidden="true">
            {
              techTickerItems.map((item) => (
                <div class="tech-ticker__item group flex items-center gap-3 py-2.5 cursor-default">
                  <span class="tech-ticker__icon-slot flex shrink-0 items-center justify-center">
                    <TechTickerIcon icon={item.icon} />
                  </span>
                  <span class="font-sans text-[11px] font-semibold tracking-[0.16em] uppercase text-rf-text-muted/60 group-hover:text-rf-text-muted transition-colors duration-300">
                    {item.name}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <LandingFeaturesSection />

    {/* High-Fidelity Rich Highlight Card at Bottom */}
    <section class="rf-container pb-4 scroll-reveal">
      <div class="highlight-card relative overflow-hidden rounded-3xl p-14 border border-rf-border/40 group/highlight">
        <Image
          src={highlightCoffee}
          alt=""
          class="highlight-card-photo"
          draggable="false"
          width={1376}
          height={768}
          widths={[768, 1024, 1376]}
          sizes="100vw"
          loading="lazy"
          decoding="async"
        />
        <div class="highlight-card-scrim" aria-hidden="true"></div>

        <div class="highlight-card-stamp">
          <InkStamp id="highlight-stamp" />
        </div>

        <div class="relative z-10 flex flex-col">
          <div class="highlight-card-copy space-y-8">

            <h2 class="text-4xl font-bold tracking-tight text-rf-text leading-[1.25]">
              {loginTrust.headline}
            </h2>

            <div class="space-y-3 text-base leading-relaxed text-rf-text-muted/90">
              {loginTrust.paragraphs.map((html) => <p set:html={html} />)}
            </div>

            <p class="flex items-start gap-2.5 border-t border-rf-border/30 pt-5 text-sm leading-relaxed text-rf-text-muted/75">
              <Icon name="shield" size={15} class="mt-[3px] shrink-0 text-rf-text-muted/60" />
              <span set:html={loginTrust.note} />
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Tech stack ticker */
  .tech-ticker {
    position: relative;
    isolation: isolate;
  }

  .tech-ticker__icon-slot {
    width: 1rem;
    height: 1rem;
  }

  .tech-ticker__icon-svg {
    display: block;
    width: 1rem;
    height: 1rem;
  }

  .tech-ticker__icon-img {
    display: block;
    width: 1rem;
    height: 1rem;
    object-fit: contain;
    opacity: 0.92;
    transition: opacity 0.3s ease;
  }

  .tech-ticker__item:hover .tech-ticker__icon-img {
    opacity: 1;
  }

  .tech-ticker__icon-slot:has(.tech-ticker__icon-img--wide) {
    width: auto;
    min-width: 1rem;
    max-width: 3.25rem;
  }

  .tech-ticker__icon-img--wide {
    width: auto;
    max-width: 3.25rem;
    height: 1rem;
  }

  /* Mask instead of color overlays: the backdrop behind the rail is not a flat color. */
  .tech-ticker__rail {
    --tech-ticker-fade: min(9rem, 18vw);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 var(--tech-ticker-fade), #000 calc(100% - var(--tech-ticker-fade)), transparent);
    mask-image: linear-gradient(90deg, transparent, #000 var(--tech-ticker-fade), #000 calc(100% - var(--tech-ticker-fade)), transparent);
  }

  /* Two identical rows, no gap between rows: pe-14 on each row matches internal gap-14 at the loop seam */
  .tech-ticker__marquee {
    will-change: transform;
  }

  .tech-ticker:hover .tech-ticker__marquee {
    animation-play-state: paused;
  }

  @keyframes marquee {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }

  .animate-marquee {
    animation: marquee 40s linear infinite;
  }

  /* Bottom highlight card: coffee photo background */
  .highlight-card {
    min-height: 18rem;
    container-type: inline-size;
  }

  .highlight-card-copy {
    max-width: 36rem;
  }

  .highlight-card-photo,
  .highlight-card-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
  }

  /* Ink stamp pressed onto the paper photo, in the right side; the copy column narrows to keep clear of it. */
  .highlight-card-stamp {
    position: absolute;
    top: 50%;
    right: clamp(1.75rem, 4.5cqi, 3.25rem);
    z-index: 10;
    display: none;
    width: clamp(7.5rem, 18cqi, 10.5rem);
    height: clamp(7.5rem, 18cqi, 10.5rem);
    color: var(--color-rf-accent);
    opacity: 0.72;
    transform: translateY(-50%) rotate(-11deg);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s ease;
  }

  .highlight-card:hover .highlight-card-stamp {
    opacity: 0.9;
    transform: translateY(-50%) rotate(-6deg);
  }

  @container (min-width: 40rem) {
    .highlight-card-stamp {
      display: block;
    }

    .highlight-card-copy {
      max-width: min(36rem, calc(100% - 11rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .highlight-card-stamp {
      transition: none;
    }
  }

  .highlight-card-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      102deg,
      rgb(29 22 19 / 0.9) 0%,
      rgb(29 22 19 / 0.78) 42%,
      rgb(29 22 19 / 0.52) 72%,
      rgb(29 22 19 / 0.38) 100%
    );
    pointer-events: none;
  }

  /* Interactive 3D Perspective Tilt on Screenshot Carousel */
  .carousel-3d-wrapper {
    transform: rotateX(5deg) translateY(-10px);
    transform-style: preserve-3d;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.8s ease, shadow 0.8s ease;
  }

  .carousel-3d-wrapper:hover {
    transform: rotateX(0deg) translateY(0px) scale(1.015);
    border-color: rgba(237, 215, 156, 0.25);
  }

  /* Entrance animations */
  .hero-title-wrap {
    margin-bottom: 0.5rem;
  }

  .hero-subcopy {
    margin-top: 0.75rem;
  }

  .animate-fade-in {
    animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .animate-slide-up {
    animation: slideUp 1s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 150ms;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Dynamic Interactive Border Spotlight */
  .card-spotlight-border {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: radial-gradient(
      140px circle at var(--mouse-x, 0px) var(--mouse-y, 0px),
      rgba(237, 215, 156, 0.28),
      transparent 80%
    );
    -webkit-mask: 
      linear-gradient(#fff, #fff) content-box, 
      linear-gradient(#fff, #fff);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 5;
  }

  .feature-card:hover .card-spotlight-border {
    opacity: 1;
  }

  /* Staggered Scroll Reveal */
  .scroll-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1), transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
  }

  .scroll-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

</style>

<script>
  import { detectPlatform, downloadCtaLabel } from '../lib/detectPlatform';

  const heroCtaLabel = document.getElementById('hero-cta-label');
  if (heroCtaLabel) heroCtaLabel.textContent = downloadCtaLabel(detectPlatform());

  // Card spotlight tracking
  function initCardSpotlights() {
    const cards = document.querySelectorAll<HTMLElement>('.feature-card, .spotlight-card');
    cards.forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty('--mouse-x', `${x}px`);
        card.style.setProperty('--mouse-y', `${y}px`);
      });
    });
  }

  // Intersection Observer for scroll-reveal animations
  function initScrollReveal() {
    const observerOptions = {
      root: null,
      rootMargin: '0px 0px -8% 0px',
      threshold: 0.02
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    document.querySelectorAll('.scroll-reveal').forEach((el) => {
      observer.observe(el);
    });
  }

  // Run initializations
  function init() {
    initCardSpotlights();
    initScrollReveal();
  }

  init();
  document.addEventListener('astro:after-swap', init);
</script>
