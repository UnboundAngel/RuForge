---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloadOwlFlow from '../components/download/DownloadOwlFlow';
import { SITE } from '../lib/site';
import {
  directInstallerDownloadUrl,
  installerFetchUrls,
  windowsInstallerFilename,
} from '../lib/downloadRelease';

const params = Astro.url.searchParams;
const autoStart = params.get('start') === '1';

const version = SITE.latestVersion;
const filename = windowsInstallerFilename(version);
const fetchUrls = installerFetchUrls(version);
const directDownloadUrl = directInstallerDownloadUrl(version);
---

<BaseLayout
  title="Download RuForge"
  description="Download RuForge for Windows. macOS and Linux builds are planned."
  flushTop
>
  <script is:inline>
    document.documentElement.classList.add('rf-dl-owl-page');
    document.addEventListener('astro:before-preparation', function() {
      document.documentElement.classList.remove('rf-dl-owl-page');
    }, { once: true });
  </script>
  <DownloadOwlFlow
    client:load
    version={version}
    fetchUrls={fetchUrls}
    directDownloadUrl={directDownloadUrl}
    filename={filename}
    autoStart={autoStart}
    troubleHref={SITE.releases}
  />
</BaseLayout>
