---
/**
 * Six feature tutorial hubs: stacked preview (step 1 cover, hover peeks 2–3) + click modal.
 * Art source: public/website/tutorials/ (copy into src/assets on update).
 */
import TutorialHubsGridReact from './TutorialHubsGrid';
import { tutorialHubsContent } from '../lib/featureTutorials';
import downloadStep1 from '../assets/tutorials/download/downloadStep1.png';
import downloadStep2 from '../assets/tutorials/download/downloadStep2.png';
import downloadStep3 from '../assets/tutorials/download/downloadStep3.png';
import libraryStep1 from '../assets/tutorials/library/libraryStep1.png';
import libraryStep2 from '../assets/tutorials/library/libraryStep2.png';
import libraryStep3 from '../assets/tutorials/library/libraryStep3.png';
import playerStep1 from '../assets/tutorials/player/playerStep1.png';
import playerStep2 from '../assets/tutorials/player/playerStep2.png';
import playerStep3 from '../assets/tutorials/player/playerStep3.png';
import sponsorStep1 from '../assets/tutorials/sponsor/sponsorStep1.png';
import sponsorStep2 from '../assets/tutorials/sponsor/sponsorStep2.png';
import sponsorStep3 from '../assets/tutorials/sponsor/sponsorStep3.png';
import miniStep1 from '../assets/tutorials/mini/miniStep1.png';
import miniStep2 from '../assets/tutorials/mini/miniStep2.png';
import miniStep3 from '../assets/tutorials/mini/miniStep3.png';
import settingsStep1 from '../assets/tutorials/settings/settingsStep1.png';
import settingsStep2 from '../assets/tutorials/settings/settingsStep2.png';
import settingsStep3 from '../assets/tutorials/settings/settingsStep3.png';

const imageByHub: Record<string, [string, string, string]> = {
  download: [downloadStep1.src, downloadStep2.src, downloadStep3.src],
  library: [libraryStep1.src, libraryStep2.src, libraryStep3.src],
  player: [playerStep1.src, playerStep2.src, playerStep3.src],
  sponsor: [sponsorStep1.src, sponsorStep2.src, sponsorStep3.src],
  mini: [miniStep1.src, miniStep2.src, miniStep3.src],
  settings: [settingsStep1.src, settingsStep2.src, settingsStep3.src],
};

const hubs = tutorialHubsContent.map((hub) => {
  const images = imageByHub[hub.id];
  return {
    id: hub.id,
    eyebrow: hub.eyebrow,
    steps: hub.steps.map((step, i) => ({
      title: step.title,
      description: step.description,
      imageSrc: images[i],
    })),
  };
});
---

<TutorialHubsGridReact client:visible hubs={hubs} />
