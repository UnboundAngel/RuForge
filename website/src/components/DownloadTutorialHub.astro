---
/**
 * Download flow: three Figma sketch frames (step label in art; site overlays title + body).
 * Art source of truth: repo-root public/website/tutorials/download/ (copy into src/assets on update).
 */
import TutorialSketchHub from './TutorialSketchHub.astro';
import downloadStep1 from '../assets/tutorials/download/downloadStep1.png';
import downloadStep2 from '../assets/tutorials/download/downloadStep2.png';
import downloadStep3 from '../assets/tutorials/download/downloadStep3.png';
---

<TutorialSketchHub
  eyebrow="How downloading works"
  steps={[
    {
      title: 'Paste the link',
      description:
        'Drop a YouTube URL into the downloader. RuForge reads title, duration, and format options immediately.',
      image: downloadStep1,
    },
    {
      title: 'Confirm and enqueue',
      description:
        'Pick quality or audio-only, then start the job. Explorer cookie sync still applies when you need it.',
      image: downloadStep2,
    },
    {
      title: 'Track the queue',
      description:
        'Follow progress, speed, and ETA in the floating queue. Finished files land in your library when done.',
      image: downloadStep3,
    },
  ]}
/>
