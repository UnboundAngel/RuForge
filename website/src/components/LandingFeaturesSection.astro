---
import { Image } from 'astro:assets';
import { landingFeatureIntro, landingFeatureRows } from '../lib/landingFeatures';
---

<section class="landing-features rf-container scroll-reveal" aria-labelledby="landing-features-heading">
  <header class="landing-features__intro">
    <p class="landing-features__kicker">{landingFeatureIntro.kicker}</p>
    <h2 id="landing-features-heading" class="landing-features__headline">
      {landingFeatureIntro.headline[0]}
      <br />
      {landingFeatureIntro.headline[1]}
    </h2>
  </header>

  <div class="landing-features__rows">
    {
      landingFeatureRows.map((row) => (
        <article
          class:list={['landing-features__row', row.reverse && 'landing-features__row--reverse']}
          id={`feature-${row.id}`}
        >
          <div class="landing-features__copy">
            <p class="landing-features__pill">{row.pill}</p>
            <h3 class="landing-features__title">
              {row.headline[0]}
              <br />
              {row.headline[1]}
            </h3>
            <p class="landing-features__body">{row.paragraph}</p>
            <ul class="landing-features__bullets">
              {row.bullets.map((item) => (
                <li>
                  <span class="landing-features__bullet-arrow" aria-hidden="true">
                    →
                  </span>
                  <span class="landing-features__bullet-text">{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <figure class="landing-features__figure">
            <div class="landing-features__frame">
              <Image
                src={row.image}
                alt={row.imageAlt}
                class="landing-features__shot"
                widths={[640, 960, 1280]}
                sizes="(max-width: 768px) 100vw, 56vw"
                loading="lazy"
                decoding="async"
              />
            </div>
          </figure>
        </article>
      ))
    }
  </div>
</section>

<style>
  .landing-features {
    --features-accent: #e8943a;
    --features-cream: var(--color-rf-text);
    --features-text-dim: var(--color-rf-text-muted);
    --features-border: var(--color-rf-border);

    padding-top: 7.5rem;
    padding-bottom: 7.5rem;
  }

  .landing-features__intro {
    max-width: 40rem;
    margin-inline: auto;
    margin-bottom: 5.5rem;
    text-align: center;
  }

  .landing-features__kicker {
    margin: 0 0 1rem;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--features-accent);
  }

  .landing-features__headline {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 4.2vw, 2.65rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: var(--features-cream);
  }

  .landing-features__rows {
    display: flex;
    flex-direction: column;
    gap: 7.5rem;
  }

  .landing-features__row {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    column-gap: 5rem;
    align-items: center;
  }

  .landing-features__row--reverse {
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
  }

  .landing-features__row--reverse .landing-features__copy {
    order: 2;
  }

  .landing-features__row--reverse .landing-features__figure {
    order: 1;
  }

  .landing-features__copy {
    max-width: 28rem;
  }

  .landing-features__pill {
    margin: 0 0 1rem;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--features-accent);
  }

  .landing-features__title {
    margin: 0 0 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 2.8vw, 2.125rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--features-cream);
  }

  .landing-features__body {
    margin: 0 0 1.35rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.7;
    color: var(--features-text-dim);
  }

  .landing-features__bullets {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .landing-features__bullets li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-rf-text);
  }

  .landing-features__bullet-arrow {
    flex-shrink: 0;
    margin-top: 0.1em;
    font-weight: 600;
    color: var(--features-accent);
    line-height: 1;
  }

  .landing-features__bullet-text {
    flex: 1;
    min-width: 0;
  }

  .landing-features__figure {
    margin: 0;
    width: 100%;
    min-width: 0;
  }

  .landing-features__frame {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid var(--features-border);
    background: var(--color-rf-surface);
    box-shadow:
      0 4px 24px rgb(0 0 0 / 0.28),
      0 0 0 1px rgb(0 0 0 / 0.12) inset;
  }

  .landing-features__shot,
  .landing-features__shot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

</style>
