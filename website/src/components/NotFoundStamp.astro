---
import { Image } from 'astro:assets';
import paper from '../assets/footer-doodles-aged-paper.webp';
import InkStamp from './InkStamp.astro';

interface Props {
  mobile?: boolean;
}

const { mobile = false } = Astro.props;
const home = mobile ? '/m/' : '/';
const download = mobile ? '/m/download' : '/download';
const stampId = mobile ? 'm-nf-stamp' : 'nf-stamp';
---

<section class:list={['nf', mobile && 'nf--mobile']}>
  <div class="nf-paper">
    <Image
      src={paper}
      alt=""
      widths={[640, 1024, 1440]}
      sizes="(max-width: 767px) 100vw, 60rem"
      class="nf-paper-photo"
      draggable="false"
    />
    <div class="nf-paper-scrim" aria-hidden="true"></div>

    <div class="nf-stage">
      <div class="nf-stamp">
        <InkStamp id={stampId} top="page not found" bottom="nothing here" mark="logo" rough />
      </div>

      <svg class="nf-splat" viewBox="0 0 320 320" aria-hidden="true">
        <circle cx="38" cy="92" r="4" />
        <circle cx="52" cy="78" r="1.8" />
        <circle cx="28" cy="110" r="1.4" />
        <circle cx="286" cy="214" r="5" />
        <circle cx="300" cy="232" r="2" />
        <circle cx="270" cy="236" r="1.5" />
        <circle cx="250" cy="48" r="2.2" />
        <circle cx="74" cy="270" r="2.6" />
        <circle cx="62" cy="284" r="1.2" />
      </svg>

      <p class="nf-note" aria-hidden="true">
        that link went <br />nowhere
        <svg class="nf-note-arrow" viewBox="0 0 90 60" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M84 6 C 70 30, 46 46, 10 50" />
          <path d="M20 40 L 9 50 L 22 57" />
        </svg>
      </p>
    </div>

    <div class="nf-copy">
      <h1 class="nf-title">We couldn't find that page</h1>
      <div class="nf-actions">
        <a href={home} class:list={['rf-btn nf-btn', mobile && 'rf-m-btn']}>Back to home</a>
        <a href={download} class:list={['rf-btn-ghost nf-btn', mobile && 'rf-m-btn']}>Download RuForge</a>
      </div>
    </div>
  </div>
</section>

<style>
  .nf {
    max-width: 62rem;
    margin: 0 auto;
    padding: 6.5rem 2rem 7rem;
  }

  .nf-paper {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    min-height: 36rem;
    padding: 3.5rem 2rem 4rem;
    overflow: hidden;
    border-radius: 28px;
    animation: nf-thud 0.5s 0.62s ease-out both;
  }

  .nf-paper-photo,
  .nf-paper-photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .nf-paper-scrim {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 42%, rgb(29 22 19 / 0.25), rgb(29 22 19 / 0.74) 80%);
  }

  .nf-stage {
    position: relative;
    z-index: 1;
    width: 20rem;
    height: 20rem;
  }

  .nf-stamp {
    position: absolute;
    inset: 1.5rem;
    color: var(--color-rf-accent);
    opacity: 0.86;
    rotate: -11deg;
    animation: nf-press 0.45s 0.3s cubic-bezier(0.2, 0.9, 0.3, 1.2) both;
  }

  .nf-splat {
    position: absolute;
    inset: 0;
    fill: var(--color-rf-accent);
    opacity: 0;
    animation: nf-fade 0.3s 0.62s ease-out forwards;
  }

  .nf-note {
    position: absolute;
    top: 0.5rem;
    left: calc(100% + 0.5rem);
    width: 10rem;
    margin: 0;
    font-family: var(--font-hand);
    font-size: 1.375rem;
    line-height: 1.15;
    color: rgb(237 215 156 / 0.78);
    rotate: 6deg;
    opacity: 0;
    animation: nf-fade 0.4s 1s ease-out forwards;
  }

  .nf-note-arrow {
    display: block;
    width: 5rem;
    margin: 0.375rem 0 0 -2.5rem;
  }

  .nf-copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  .nf-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--color-rf-text);
  }

  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.625rem;
  }

  .nf-btn {
    padding-inline: 1.5rem;
  }

  @keyframes nf-press {
    from {
      opacity: 0;
      scale: 1.9;
    }
    to {
      opacity: 0.86;
      scale: 1;
    }
  }

  @keyframes nf-fade {
    to {
      opacity: 1;
    }
  }

  @keyframes nf-thud {
    0%,
    100% {
      translate: 0 0;
    }
    30% {
      translate: 0 3px;
    }
    60% {
      translate: 0 -1px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nf-paper,
    .nf-stamp,
    .nf-splat,
    .nf-note {
      animation: none;
    }

    .nf-splat,
    .nf-note {
      opacity: 1;
    }
  }

  .nf--mobile {
    padding: 0;
  }

  .nf--mobile .nf-paper {
    min-height: 34rem;
    padding: 2.5rem 1.25rem 2rem;
    border-radius: 24px;
  }

  .nf--mobile .nf-stage {
    width: 15rem;
    height: 15rem;
  }

  .nf--mobile .nf-stamp {
    inset: 1rem;
  }

  .nf--mobile .nf-stage {
    margin-bottom: 1.5rem;
  }

  .nf--mobile .nf-note {
    top: calc(100% + 0.25rem);
    left: 50%;
    width: max-content;
    font-size: 1.25rem;
    translate: -50% 0;
    rotate: -3deg;
  }

  .nf--mobile .nf-note br {
    display: none;
  }

  .nf--mobile .nf-note-arrow {
    display: none;
  }

  .nf--mobile .nf-title {
    font-size: 2rem;
  }

  .nf--mobile .nf-actions {
    flex-direction: column;
    align-self: stretch;
  }

  .nf--mobile .nf-btn {
    width: 100%;
    padding-block: 0.75rem;
  }
</style>
