---
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import ruforgeLogo from '../assets/ruforge-logo.png';
import footerDoodles from '../assets/footer-doodles-aged-paper.webp';
import { SITE } from '../lib/site';

const productLinks = [
  { href: '/features', label: 'Features', icon: 'star' as const },
  { href: '/docs', label: 'Docs', icon: 'file' as const },
  { href: '/resources/getting-started', label: 'Getting started', icon: 'play' as const },
  { href: '/changelog', label: 'Changelog', icon: 'list' as const },
  { href: '/roadmap', label: 'Roadmap', icon: 'map' as const },
  { href: SITE.releases, label: 'Releases', icon: 'download' as const },
];

const communityLinks = [
  { href: SITE.github, label: 'GitHub', icon: 'github' as const },
  { href: SITE.discussions, label: 'Discussions', icon: 'message' as const },
  { href: `${SITE.github}/issues`, label: 'Issue Tracker', icon: 'wrench' as const },
];

const legalLinks = [
  { href: '/legal/privacy', label: 'Privacy Policy', icon: 'shield' as const },
  { href: '/legal/terms', label: 'Terms of Use', icon: 'scale' as const },
  { href: '/legal/notice', label: 'Legal Notice', icon: 'file' as const },
  { href: SITE.license, label: 'Apache-2.0 License', icon: 'external' as const },
];
---

<footer class="site-footer mt-20 md:mt-28 text-sm text-rf-text-muted">
  <div class="site-footer__media" aria-hidden="true">
    <Image
      src={footerDoodles}
      alt=""
      class="site-footer__photo"
      width={1376}
      height={768}
      widths={[768, 1024, 1376]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="site-footer__top-fade" aria-hidden="true"></div>
  <div class="site-footer__scrim" aria-hidden="true"></div>

  <div class="site-footer__content rf-container relative z-10 pb-14 md:pb-16">
    <div class="grid gap-12 sm:grid-cols-2 md:grid-cols-4">
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <Image
            src={ruforgeLogo}
            alt="RuForge logo"
            width={28}
            height={28}
            widths={[28, 56]}
            class="rounded-md"
            loading="lazy"
          />
          <span class="text-base font-semibold tracking-tight text-rf-text">RuForge</span>
        </div>
        <p class="max-w-xs text-xs leading-relaxed text-rf-text-muted/95">
          The lightweight, local-first media manager and downloader for Windows. Built with Tauri, Rust, and React.
        </p>
      </div>

      <div class="space-y-4">
        <h3 class="text-xs font-semibold tracking-wider text-rf-text uppercase">Product</h3>
        <ul class="space-y-3">
          {
            productLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex items-center gap-2 text-rf-text-muted no-underline transition-colors hover:text-rf-text"
                >
                  <Icon name={link.icon} size={15} class="opacity-80" />
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="space-y-4">
        <h3 class="text-xs font-semibold tracking-wider text-rf-text uppercase">Community</h3>
        <ul class="space-y-3">
          {
            communityLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex items-center gap-2 text-rf-text-muted no-underline transition-colors hover:text-rf-text"
                >
                  <Icon name={link.icon} size={15} class="opacity-80" />
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="space-y-4">
        <h3 class="text-xs font-semibold tracking-wider text-rf-text uppercase">Legal</h3>
        <ul class="space-y-3">
          {
            legalLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex items-center gap-2 text-rf-text-muted no-underline transition-colors hover:text-rf-text"
                >
                  <Icon name={link.icon} size={15} class="opacity-80" />
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-4 border-t border-rf-border/25 pt-6 text-xs text-rf-text-muted/90 sm:flex-row sm:items-center sm:justify-between md:mt-16"
    >
      <p class="leading-relaxed">
        &copy; {new Date().getFullYear()} RuForge. Apache-2.0 licensed. Not affiliated with YouTube or Google.
      </p>
      <div class="flex flex-wrap gap-x-6 gap-y-2">
        <a href="/legal/privacy" class="text-rf-text-muted no-underline hover:text-rf-text">Privacy Policy</a>
        <a href="/legal/terms" class="text-rf-text-muted no-underline hover:text-rf-text">Terms of Use</a>
        <a href="/legal/notice" class="text-rf-text-muted no-underline hover:text-rf-text">Legal Notice</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    border-radius: 2.75rem 2.75rem 0 0;
    isolation: isolate;
  }

  .site-footer__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .site-footer__photo,
  .site-footer__photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 38%;
  }

  .site-footer__top-fade {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1;
    height: 7rem;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      var(--color-rf-bg) 0%,
      rgb(29 22 19 / 0.72) 38%,
      transparent 100%
    );
  }

  .site-footer__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgb(29 22 19 / 0.42) 0%,
      rgb(29 22 19 / 0.28) 45%,
      rgb(29 22 19 / 0.38) 100%
    );
  }

  .site-footer__content {
    /* Clear the top fade band so columns sit on readable paper */
    padding-top: 10.5rem;
  }

  @media (min-width: 768px) {
    .site-footer {
      border-radius: 3.5rem 3.5rem 0 0;
    }

    .site-footer__top-fade {
      height: 9rem;
    }

    .site-footer__content {
      padding-top: 12.5rem;
    }
  }
</style>
