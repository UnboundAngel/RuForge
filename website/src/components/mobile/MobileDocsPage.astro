---
import { Image } from 'astro:assets';
import { SpiralLoader } from '../SpiralLoader';
import type { DocsPage } from '../../lib/docsTree';
import { docsNavNeighbors } from '../../lib/docsTree';
import { SITE } from '../../lib/site';
import { DOCS_CONTENT, type DocsSectionContent } from '../../lib/docsContent';
import { GLOSSARY_TERMS } from '../../lib/glossaryTerms';

interface Props {
  page: DocsPage;
}

const { page } = Astro.props;
const { prev, next } = docsNavNeighbors(page.slug);
const pageContent = DOCS_CONTENT[page.slug];

const docsImageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/tutorials/docs/*.png',
  { eager: true },
);

function docsImage(filename: string): ImageMetadata | undefined {
  for (const [path, mod] of Object.entries(docsImageModules)) {
    if (path.endsWith('/' + filename)) return mod.default;
  }
  return undefined;
}

function sectionContent(heading: string): DocsSectionContent | undefined {
  return pageContent?.[heading];
}
---

<div class="mb-6">
  <a href="/m/docs" class="rf-m-btn inline-flex items-center gap-1.5 text-sm text-rf-text-muted no-underline hover:text-rf-text mb-4">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M15 18l-6-6 6-6" />
    </svg>
    Docs
  </a>

  <h1 class="font-display text-2xl font-bold tracking-tight text-rf-text leading-tight">
    {page.title}
  </h1>
  <p class="mt-2 text-sm text-rf-text-muted/80 leading-relaxed">
    {page.description}
  </p>
</div>

{page.outline.length > 0 && (
  <nav class="mb-6 rounded-xl border border-rf-border/20 bg-rf-surface/20 px-4 py-3">
    <p class="text-[10px] font-semibold tracking-widest text-rf-text-muted/60 uppercase mb-2">On this page</p>
    <ul class="space-y-1">
      {page.outline.map((heading) => (
        <li>
          <a
            href={`#${heading.toLowerCase().replace(/\s+/g, '-')}`}
            class="rf-m-link block text-sm text-rf-text-muted/80 no-underline hover:text-rf-accent py-0.5"
          >
            {heading}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<div class="space-y-6">
  {page.outline.length > 0 ? (
    page.outline.map((heading) => {
      const sc = sectionContent(heading);
      return (
        <section id={heading.toLowerCase().replace(/\s+/g, '-')} class="scroll-mt-20">
          <h2 class="text-lg font-semibold text-rf-text mb-3 pb-2 border-b border-rf-border/10">
            {heading}
            {sc?.headingWidget === 'spiral-loader' && (
              <SpiralLoader size={18} client:load />
            )}
          </h2>

          {sc?.image && docsImage(sc.image) && (
            <figure class="mb-3">
              <Image
                src={docsImage(sc.image)!}
                alt={heading}
                widths={[360, 480]}
                sizes="100vw"
                class="w-full h-auto rounded-lg border border-rf-border/10"
              />
            </figure>
          )}

          {sc ? (
            <div class="space-y-3">
              {sc.paragraphs?.map((p) => <p class="text-sm leading-relaxed text-rf-text-muted" set:html={p} />)}

              {sc.steps && (
                <ol class="list-decimal list-inside space-y-2 text-sm text-rf-text-muted">
                  {sc.steps.map((s) => <li set:html={s} />)}
                </ol>
              )}

              {sc.bullets && (
                <ul class="space-y-1.5 text-sm text-rf-text-muted">
                  {sc.bullets.map((b) => (
                    <li class="flex gap-2">
                      <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-rf-accent/60" aria-hidden="true" />
                      <span set:html={b} />
                    </li>
                  ))}
                </ul>
              )}

              {sc.paragraphs2?.map((p) => <p class="text-sm leading-relaxed text-rf-text-muted" set:html={p} />)}
              {sc.paragraphs3?.map((p) => <p class="text-sm leading-relaxed text-rf-text-muted" set:html={p} />)}

              {sc.note && (
                <aside class="flex gap-2.5 px-3 py-2.5 rounded-lg bg-[rgb(212_165_116/0.06)] border-l-2 border-[rgb(212_165_116/0.3)] text-sm text-rf-text-muted">
                  <span class="shrink-0 mt-0.5 text-rf-accent">i</span>
                  <p set:html={sc.note} />
                </aside>
              )}

              {sc.tip && (
                <aside class="flex gap-2.5 px-3 py-2.5 rounded-lg bg-[rgb(156_184_106/0.06)] border-l-2 border-[rgb(156_184_106/0.3)] text-sm text-rf-text-muted">
                  <span class="shrink-0 mt-0.5 text-[rgb(156_184_106)]">*</span>
                  <p set:html={sc.tip} />
                </aside>
              )}

              {sc.warning && (
                <aside class="flex gap-2.5 px-3 py-2.5 rounded-lg bg-[rgb(220_120_60/0.08)] border-l-2 border-[rgb(220_120_60/0.45)] text-sm text-rf-text-muted">
                  <span class="shrink-0 mt-0.5 text-[rgb(220_120_60)]">!</span>
                  <p set:html={sc.warning} />
                </aside>
              )}

              {sc.table && (
                <div class="overflow-x-auto rounded-lg border border-rf-border/10">
                  <table class="w-full text-sm">
                    <thead>
                      <tr class="border-b border-rf-border/10">
                        {sc.table.headers.map((h) => (
                          <th class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wider text-rf-accent">{h}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {sc.table.rows.map((row) => (
                        <tr class="border-b border-rf-border/5 last:border-0">
                          {row.map((cell) => <td class="px-3 py-2 text-rf-text-muted" set:html={cell} />)}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}

              {sc.collapsible && (
                <details class="rounded-lg border border-[rgb(220_120_60/0.15)] bg-[rgb(220_120_60/0.04)]">
                  <summary class="px-3 py-2 text-xs font-semibold text-[rgb(220_140_80)] cursor-pointer select-none">{sc.collapsible.label}</summary>
                  <div class="px-3 pb-2.5 text-sm text-rf-text-muted" set:html={sc.collapsible.content} />
                </details>
              )}

              {sc.codeBlock && (
                <div class="rounded-lg border border-rf-border/10 bg-black/20 overflow-hidden">
                  {sc.codeBlock.lang && <span class="block px-3 py-1.5 text-[10px] font-mono uppercase tracking-wider text-rf-text-muted/50 border-b border-rf-border/5">{sc.codeBlock.lang}</span>}
                  <pre class="px-3 py-2.5 text-xs font-mono leading-relaxed text-rf-text overflow-x-auto"><code set:html={sc.codeBlock.code} /></pre>
                </div>
              )}
            </div>
          ) : (
            <p class="text-sm text-rf-text-muted/60">
              Full write-up coming soon. Check{' '}
              <a href="/m/docs/common-issues" class="text-rf-accent no-underline">Troubleshooting</a>{' '}
              or{' '}
              <a href={SITE.discussions} class="text-rf-accent no-underline" target="_blank" rel="noopener noreferrer">GitHub Discussions</a>.
            </p>
          )}
        </section>
      );
    })
  ) : (
    <section class="rounded-xl border border-rf-border/30 bg-rf-surface/30 px-4 py-4">
      <p class="text-sm text-rf-text-muted/60">Content for this page is coming soon.</p>
    </section>
  )}
</div>

{(prev || next) && (
  <nav class="mt-8 grid grid-cols-2 gap-3" aria-label="Page navigation">
    {prev ? (
      <a href={`/m/docs/${prev.slug}`} class="rf-m-link flex flex-col gap-0.5 px-3 py-2.5 rounded-xl border border-rf-border/15 no-underline hover:border-rf-accent/20">
        <span class="text-[10px] font-semibold uppercase tracking-wider text-rf-text-muted/50">Previous</span>
        <span class="text-sm font-medium text-rf-accent truncate">{prev.title}</span>
      </a>
    ) : <div />}
    {next ? (
      <a href={`/m/docs/${next.slug}`} class="rf-m-link flex flex-col gap-0.5 px-3 py-2.5 rounded-xl border border-rf-border/15 no-underline hover:border-rf-accent/20 text-right">
        <span class="text-[10px] font-semibold uppercase tracking-wider text-rf-text-muted/50">Next</span>
        <span class="text-sm font-medium text-rf-accent truncate">{next.title}</span>
      </a>
    ) : <div />}
  </nav>
)}

<div id="glossary-terms" hidden set:html={JSON.stringify(GLOSSARY_TERMS)} />
