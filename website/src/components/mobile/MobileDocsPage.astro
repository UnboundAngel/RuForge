---
import { Image } from 'astro:assets';
import { SpiralLoader } from '../SpiralLoader';
import MobilePageHeader from './MobilePageHeader.astro';
import Disclosure from '../Disclosure.astro';
import type { DocsPage } from '../../lib/docsTree';
import { docsNavNeighbors } from '../../lib/docsTree';
import { SITE } from '../../lib/site';
import { DOCS_CONTENT, type DocsSectionContent } from '../../lib/docsContent';
import { GLOSSARY_TERMS } from '../../lib/glossaryTerms';

interface Props {
  page: DocsPage;
}

const { page } = Astro.props;
const { prev, next } = docsNavNeighbors(page.slug);
const pageContent = DOCS_CONTENT[page.slug];

const docsImageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/tutorials/docs/*.png',
  { eager: true },
);

function docsImage(filename: string): ImageMetadata | undefined {
  for (const [path, mod] of Object.entries(docsImageModules)) {
    if (path.endsWith('/' + filename)) return mod.default;
  }
  return undefined;
}

function sectionContent(heading: string): DocsSectionContent | undefined {
  return pageContent?.[heading];
}

function sectionId(heading: string): string {
  return heading.toLowerCase().replace(/\s+/g, '-');
}
---

<MobilePageHeader title={page.title} description={page.description} backHref="/m/docs" backLabel="Docs" />

{page.outline.length > 0 && (
  <nav class="mb-10 rounded-xl bg-rf-surface px-4 py-3" aria-label="On this page">
    <p class="mb-1.5 text-[10px] font-semibold uppercase tracking-widest text-rf-text-muted/60">On this page</p>
    <ul>
      {page.outline.map((heading) => (
        <li>
          <a
            href={`#${sectionId(heading)}`}
            data-toc-link
            class="rf-m-link -mx-2 block rounded-lg px-2 py-1.5 text-[15px] text-rf-text-muted/80 no-underline"
          >
            {heading}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<div class="space-y-12">
  {page.outline.length > 0 ? (
    page.outline.map((heading) => {
      const sc = sectionContent(heading);
      return (
        <section id={sectionId(heading)} class="scroll-mt-24">
          <h2 class="mb-4 flex items-center gap-2 font-display text-xl font-semibold tracking-tight text-rf-text">
            {heading}
            {sc?.headingWidget === 'spiral-loader' && <SpiralLoader size={18} client:load />}
          </h2>

          {sc?.image && docsImage(sc.image) && (
            <figure class="mb-5">
              <Image
                src={docsImage(sc.image)!}
                alt={heading}
                widths={[360, 480, 720]}
                sizes="100vw"
                draggable="false"
                class="h-auto w-full rounded-xl"
              />
            </figure>
          )}

          {sc ? (
            <div class="rf-m-read space-y-4">
              {sc.paragraphs?.map((p) => <p set:html={p} />)}

              {sc.steps && (
                <ol class="space-y-3 py-2">
                  {sc.steps.map((s, i) => (
                    <li class="flex gap-3">
                      <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-rf-accent/12 text-xs font-semibold tabular-nums text-rf-accent">
                        {i + 1}
                      </span>
                      <span set:html={s} />
                    </li>
                  ))}
                </ol>
              )}

              {sc.bullets && (
                <ul class="space-y-2 py-2">
                  {sc.bullets.map((b) => (
                    <li class="flex gap-3">
                      <span class="mt-3 h-1 w-1 shrink-0 rounded-full bg-rf-accent/60" aria-hidden="true" />
                      <span set:html={b} />
                    </li>
                  ))}
                </ul>
              )}

              {sc.paragraphs2?.map((p) => <p set:html={p} />)}
              {sc.paragraphs3?.map((p) => <p set:html={p} />)}

              {sc.note && (
                <aside class="rf-callout rf-callout--note">
                  <span class="rf-callout__icon" aria-hidden="true" />
                  <p set:html={sc.note} />
                </aside>
              )}

              {sc.tip && (
                <aside class="rf-callout rf-callout--tip">
                  <span class="rf-callout__icon" aria-hidden="true" />
                  <p set:html={sc.tip} />
                </aside>
              )}

              {sc.warning && (
                <aside class="rf-callout rf-callout--warning">
                  <span class="rf-callout__icon" aria-hidden="true" />
                  <p set:html={sc.warning} />
                </aside>
              )}

              {sc.table && (
                <div class="rf-doc-table-wrap">
                  <table class="rf-doc-table">
                    <thead>
                      <tr>{sc.table.headers.map((h) => <th>{h}</th>)}</tr>
                    </thead>
                    <tbody>
                      {sc.table.rows.map((row) => (
                        <tr>{row.map((cell) => <td set:html={cell} />)}</tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}

              {sc.collapsible && (
                <div>
                  <Disclosure id={`m-docs-more-${sectionId(heading)}`} buttonClass="rf-doc-disclosure">
                    <span slot="trigger">{sc.collapsible.label}</span>
                    <svg slot="trigger" class="shrink-0 transition-transform duration-300 group-aria-expanded:rotate-180 motion-reduce:transition-none" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M6 9l6 6 6-6" />
                    </svg>
                    <div class="rf-doc-disclosure-body" set:html={sc.collapsible.content} />
                  </Disclosure>
                </div>
              )}

              {sc.codeBlock && (
                <div class="overflow-hidden rounded-xl border border-rf-border/10 bg-black/20">
                  {sc.codeBlock.lang && <span class="block border-b border-rf-border/5 px-3 py-1.5 font-mono text-[10px] uppercase tracking-wider text-rf-text-muted/50">{sc.codeBlock.lang}</span>}
                  <pre class="overflow-x-auto px-3 py-2.5 font-mono text-xs leading-relaxed text-rf-text"><code set:html={sc.codeBlock.code} /></pre>
                </div>
              )}
            </div>
          ) : (
            <p class="rf-m-read text-rf-text-muted/60">
              Full write-up coming soon. Check{' '}
              <a href="/m/docs/common-issues" class="rf-inline-link rf-m-link">Troubleshooting</a>{' '}
              or{' '}
              <a href={SITE.discussions} class="rf-inline-link rf-m-link" target="_blank" rel="noopener noreferrer">GitHub Discussions</a>.
            </p>
          )}
        </section>
      );
    })
  ) : (
    <p class="rf-m-read rounded-xl bg-rf-surface px-4 py-4 text-rf-text-muted/60">Content for this page is coming soon.</p>
  )}
</div>

{(prev || next) && (
  <nav class="mt-14 flex items-start justify-between gap-3" aria-label="Page navigation">
    {prev ? (
      <a href={`/m/docs/${prev.slug}`} class="rf-m-card flex max-w-[48%] flex-col gap-0.5 rounded-xl border border-rf-accent/20 px-4 py-3 no-underline">
        <span class="text-[10px] font-semibold uppercase tracking-wider text-rf-text-muted/60">Previous</span>
        <span class="text-sm font-semibold text-rf-accent">{prev.title}</span>
      </a>
    ) : <span />}
    {next ? (
      <a href={`/m/docs/${next.slug}`} class="rf-m-card flex max-w-[48%] flex-col items-end gap-0.5 rounded-xl border border-rf-accent/20 px-4 py-3 text-right no-underline">
        <span class="text-[10px] font-semibold uppercase tracking-wider text-rf-text-muted/60">Next</span>
        <span class="text-sm font-semibold text-rf-accent">{next.title}</span>
      </a>
    ) : <span />}
  </nav>
)}

<div id="glossary-terms" hidden set:html={JSON.stringify(GLOSSARY_TERMS)} />

<script>
  import { initDocsToc } from '../../lib/docsToc';

  initDocsToc(96);
</script>
