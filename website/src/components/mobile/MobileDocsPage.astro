---
import { Image } from 'astro:assets';
import { SpiralLoader } from '../SpiralLoader';
import MobilePageHeader from './MobilePageHeader.astro';
import MobileDocsSectionBody from './MobileDocsSectionBody.astro';
import MobileDocsCardTips from './MobileDocsCardTips.astro';
import Disclosure from '../Disclosure.astro';
import type { DocsPage } from '../../lib/docsTree';
import { docsNavNeighbors } from '../../lib/docsTree';
import { SITE } from '../../lib/site';
import { DOCS_CONTENT, type DocsSectionContent } from '../../lib/docsContent';
import { docsReadingMinutes } from '../../lib/docsReading';
import { GLOSSARY_TERMS } from '../../lib/glossaryTerms';

interface Props {
  page: DocsPage;
}

const { page } = Astro.props;
const { prev, next } = docsNavNeighbors(page.slug);
const pageContent = DOCS_CONTENT[page.slug];
const readingMinutes = docsReadingMinutes(page.slug);

const docsImageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/tutorials/docs/*.png',
  { eager: true },
);

function docsImage(filename: string): ImageMetadata | undefined {
  for (const [path, mod] of Object.entries(docsImageModules)) {
    if (path.endsWith('/' + filename)) return mod.default;
  }
  return undefined;
}

function sectionContent(heading: string): DocsSectionContent | undefined {
  return pageContent?.[heading];
}

function sectionId(heading: string): string {
  return heading.toLowerCase().replace(/\s+/g, '-');
}

function hasMoreThanLead(sc: DocsSectionContent): boolean {
  return Boolean(
    (sc.paragraphs?.length ?? 0) > 1 ||
      sc.steps || sc.bullets || sc.paragraphs2 || sc.paragraphs3 ||
      sc.note || sc.tip || sc.warning || sc.table || sc.collapsible || sc.codeBlock,
  );
}
---

<div class="rf-read-progress" data-read-progress aria-hidden="true" />

<MobilePageHeader title={page.title} description={page.description} backHref="/m/docs" backLabel="Docs">
  {readingMinutes && (
    <p class="mt-3 text-xs font-medium text-rf-text-muted/60">
      {readingMinutes} min read · {page.outline.length} {page.outline.length === 1 ? 'section' : 'sections'}
    </p>
  )}
</MobilePageHeader>

{page.outline.length > 0 && (
  <nav class="mb-8 rounded-xl bg-rf-surface px-4 py-3" aria-label="On this page">
    <p class="mb-1.5 text-[10px] font-semibold uppercase tracking-widest text-rf-text-muted/60">On this page</p>
    <ul>
      {page.outline.map((heading) => (
        <li>
          <a
            href={`#${sectionId(heading)}`}
            data-toc-link
            class="rf-m-link -mx-2 block rounded-lg px-2 py-1.5 text-[15px] text-rf-text-muted/80 no-underline"
          >
            {heading}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<div class="space-y-4">
  {page.outline.length > 0 ? (
    page.outline.map((heading) => {
      const sc = sectionContent(heading);
      const id = sectionId(heading);
      const image = sc?.image ? docsImage(sc.image) : undefined;
      const lead = sc?.paragraphs?.[0];
      const collapse = Boolean(sc && lead && hasMoreThanLead(sc));
      return (
        <section id={id} class:list={['rf-doc-card scroll-mt-24 overflow-hidden rounded-2xl bg-rf-surface', collapse && 'cursor-pointer']} data-doc-card={collapse ? '' : undefined}>
          {image && (
            <Image
              src={image}
              alt=""
              widths={[360, 480, 720]}
              sizes="100vw"
              draggable="false"
              class="block h-auto w-full"
            />
          )}

          <div class="px-4 pt-4 pb-5">
            <h2 class="flex items-center gap-2 font-display text-xl font-semibold tracking-tight text-rf-text">
              <span class="rf-heading-text">{heading}</span>
              {sc?.headingWidget === 'spiral-loader' && <SpiralLoader size={18} client:load />}
            </h2>

            {!sc ? (
              <p class="rf-m-read rf-doc-prose mt-2 text-rf-text-muted/70">
                Full write-up coming soon. Check{' '}
                <a href="/m/docs/common-issues" class="rf-m-link">Troubleshooting</a>{' '}
                or{' '}
                <a href={SITE.discussions} class="rf-m-link" target="_blank" rel="noopener noreferrer">GitHub Discussions</a>.
              </p>
            ) : collapse ? (
              <p class="rf-m-read rf-doc-prose mt-2" set:html={lead} />
            ) : (
              <div class="mt-3">
                <MobileDocsSectionBody sc={sc} id={id} skipLead={false} />
              </div>
            )}
          </div>

          {sc && !collapse && <MobileDocsCardTips sc={sc} />}

          {sc && collapse && (
            <Disclosure id={`m-docs-more-${id}`} buttonClass="rf-section-more">
              <div class="px-4 pt-4 pb-5">
                <MobileDocsSectionBody sc={sc} id={id} skipLead />
              </div>
              <MobileDocsCardTips sc={sc} />
              <span slot="trigger" data-when-closed>Read more</span>
              <span slot="trigger" data-when-open hidden>Show less</span>
              <svg slot="trigger" class="shrink-0 transition-transform duration-300 group-aria-expanded:rotate-180 motion-reduce:transition-none" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 9l6 6 6-6" />
              </svg>
            </Disclosure>
          )}
        </section>
      );
    })
  ) : (
    <p class="rf-m-read rounded-xl bg-rf-surface px-4 py-4 text-rf-text-muted/60">Content for this page is coming soon.</p>
  )}
</div>

{(prev || next) && (
  <nav class="mt-12 flex items-start justify-between gap-3" aria-label="Page navigation">
    {prev ? (
      <a href={`/m/docs/${prev.slug}`} class="rf-m-card flex max-w-[48%] flex-col gap-0.5 rounded-xl border border-rf-accent/20 px-4 py-3 no-underline">
        <span class="text-[10px] font-semibold uppercase tracking-wider text-rf-text-muted/60">Previous</span>
        <span class="text-sm font-semibold text-rf-accent">{prev.title}</span>
      </a>
    ) : <span />}
    {next ? (
      <a href={`/m/docs/${next.slug}`} class="rf-m-card flex max-w-[48%] flex-col items-end gap-0.5 rounded-xl border border-rf-accent/20 px-4 py-3 text-right no-underline">
        <span class="text-[10px] font-semibold uppercase tracking-wider text-rf-text-muted/60">Next</span>
        <span class="text-sm font-semibold text-rf-accent">{next.title}</span>
      </a>
    ) : <span />}
  </nav>
)}

<div id="glossary-terms" hidden set:html={JSON.stringify(GLOSSARY_TERMS)} />

<script>
  import { initDocsToc, initReadingProgress } from '../../lib/docsToc';

  initDocsToc(96);
  initReadingProgress();

  document.querySelectorAll<HTMLElement>('[data-doc-card]').forEach((card) => {
    card.addEventListener('click', (event) => {
      const target = event.target as Element | null;
      if (target?.closest('a, button, .rf-doc-disclosure')) return;
      if (window.getSelection()?.toString()) return;
      card.querySelector<HTMLButtonElement>(':scope > [data-disclosure]')?.click();
    });
  });
</script>
