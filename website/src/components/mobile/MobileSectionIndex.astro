---
import type { NavSection } from '../../lib/sitePages';
import { pageHref } from '../../lib/sitePages';
import { mobileHref } from '../../lib/mobileHref';
import MobilePageHeader from './MobilePageHeader.astro';
import MobileRow from './MobileRow.astro';

interface Props {
  section: NavSection;
}

const { section } = Astro.props;
---

<MobilePageHeader title={section.label} description={section.description} />

<ul class="space-y-2">
  {
    section.pages.map((page) => (
      <li>
        <MobileRow
          href={mobileHref(page.externalHref ?? pageHref(section.id, page.slug))}
          title={page.title}
          meta={page.description}
        />
      </li>
    ))
  }
</ul>
