---
import { Image } from 'astro:assets';
import MobilePageHeader from './MobilePageHeader.astro';
import Disclosure from '../Disclosure.astro';
import { FEATURE_PAGES, featureReadingMinutes, type FeaturePageDef } from '../../lib/featurePageData';

interface Props {
  page: FeaturePageDef;
}

const { page } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/tutorials/**/*.{png,webp}',
  { eager: true },
);

function resolveImage(dir: string, filename: string): ImageMetadata | undefined {
  for (const [path, mod] of Object.entries(allImages)) {
    if (path.includes(`/${dir}/`) && path.endsWith(`/${filename}`)) return mod.default;
  }
  return undefined;
}

function sectionId(heading: string): string {
  return heading.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}

const readingMinutes = featureReadingMinutes(page);

const index = FEATURE_PAGES.findIndex((p) => p.slug === page.slug);
const prev = index > 0 ? FEATURE_PAGES[index - 1] : undefined;
const next = index < FEATURE_PAGES.length - 1 ? FEATURE_PAGES[index + 1] : undefined;
---

<div class="rf-read-progress" data-read-progress aria-hidden="true" />

<MobilePageHeader title={page.title} description={page.description} backHref="/m/features" backLabel="Features">
  <p class="mt-3 text-xs font-medium text-rf-text-muted/60">
    {readingMinutes} min read · {page.sections.length} {page.sections.length === 1 ? 'section' : 'sections'}
  </p>
</MobilePageHeader>

<nav class="mb-8 rounded-xl bg-rf-surface px-4 py-3" aria-label="On this page">
  <p class="mb-1.5 text-[10px] font-semibold uppercase tracking-widest text-rf-text-muted/60">On this page</p>
  <ul>
    {page.sections.map((section) => (
      <li>
        <a
          href={`#${sectionId(section.heading)}`}
          data-toc-link
          class="rf-m-link -mx-2 block rounded-lg px-2 py-1.5 text-[15px] text-rf-text-muted/80 no-underline"
        >
          {section.heading}
        </a>
      </li>
    ))}
  </ul>
</nav>

<div class="space-y-4">
  {page.sections.map((section) => {
    const id = sectionId(section.heading);
    const img = resolveImage(page.imageDir, section.imageFile);
    const stepFrame = section.imageFile.includes('Step');
    const collapse = section.bullets.length > 0;
    return (
      <section id={id} class:list={['rf-doc-card scroll-mt-24 overflow-hidden rounded-2xl bg-rf-surface', collapse && 'rf-m-card cursor-pointer']} data-doc-card={collapse ? '' : undefined}>
        {img && (stepFrame ? (
          <div class="rf-step-shot">
            <Image src={img} alt={section.imageAlt} widths={[480, 720]} sizes="110vw" draggable="false" />
          </div>
        ) : (
          <Image src={img} alt={section.imageAlt} widths={[360, 480, 720]} sizes="100vw" draggable="false" class="block h-auto w-full" />
        ))}

        <div class="px-4 pt-4 pb-5">
          <h2 class="font-display text-xl font-semibold tracking-tight text-rf-text">
            <span class="rf-heading-text">{section.heading}</span>
          </h2>
          <p class="rf-m-read mt-2">{section.body}</p>
        </div>

        {collapse && (
          <Disclosure id={`m-feature-more-${id}`} buttonClass="rf-section-more">
            <ul class="rf-m-read space-y-2 px-4 pt-4 pb-5">
              {section.bullets.map((b) => (
                <li class="flex gap-3">
                  <span class="mt-3 h-1 w-1 shrink-0 rounded-full bg-rf-accent/60" aria-hidden="true" />
                  <span>{b}</span>
                </li>
              ))}
            </ul>
            <span slot="trigger" data-when-closed>Read more</span>
            <span slot="trigger" data-when-open hidden>Show less</span>
            <svg slot="trigger" class="shrink-0 transition-transform duration-300 group-aria-expanded:rotate-180 motion-reduce:transition-none" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 9l6 6 6-6" />
            </svg>
          </Disclosure>
        )}
      </section>
    );
  })}
</div>

{(prev || next) && (
  <nav class="mt-12 flex items-start justify-between gap-3" aria-label="Page navigation">
    {prev ? (
      <a href={`/m/features/${prev.slug}`} class="rf-m-card flex max-w-[48%] flex-col gap-0.5 rounded-xl border border-rf-accent/20 px-4 py-3 no-underline">
        <span class="text-[10px] font-semibold uppercase tracking-wider text-rf-text-muted/60">Previous</span>
        <span class="text-sm font-semibold text-rf-accent">{prev.title}</span>
      </a>
    ) : <span />}
    {next ? (
      <a href={`/m/features/${next.slug}`} class="rf-m-card flex max-w-[48%] flex-col items-end gap-0.5 rounded-xl border border-rf-accent/20 px-4 py-3 text-right no-underline">
        <span class="text-[10px] font-semibold uppercase tracking-wider text-rf-text-muted/60">Next</span>
        <span class="text-sm font-semibold text-rf-accent">{next.title}</span>
      </a>
    ) : <span />}
  </nav>
)}

<script>
  import { initDocsToc, initReadingProgress } from '../../lib/docsToc';

  initDocsToc(96);
  initReadingProgress();

  document.querySelectorAll<HTMLElement>('[data-doc-card]').forEach((card) => {
    card.addEventListener('click', (event) => {
      const target = event.target as Element | null;
      if (target?.closest('a, button')) return;
      if (window.getSelection()?.toString()) return;
      card.querySelector<HTMLButtonElement>(':scope > [data-disclosure]')?.click();
    });
  });
</script>
