---
import Icon from '../Icon.astro';
import { Image } from 'astro:assets';
import ruforgeLogo from '../../assets/ruforge-logo.png';
import footerDoodles from '../../assets/footer-doodles-aged-paper.webp';
import { SITE } from '../../lib/site';

const productLinks = [
  { href: '/features', label: 'Features', icon: 'star' as const },
  { href: '/docs', label: 'Docs', icon: 'file' as const },
  { href: '/resources/getting-started', label: 'Getting started', icon: 'play' as const },
  { href: '/changelog', label: 'Changelog', icon: 'list' as const },
  { href: '/roadmap', label: 'Roadmap', icon: 'map' as const },
  { href: SITE.releases, label: 'Releases', icon: 'download' as const },
];

const communityLinks = [
  { href: SITE.github, label: 'GitHub', icon: 'github' as const },
  { href: SITE.discussions, label: 'Discussions', icon: 'message' as const },
  { href: `${SITE.github}/issues`, label: 'Issue Tracker', icon: 'wrench' as const },
];

const legalLinks = [
  { href: '/legal/privacy', label: 'Privacy Policy', icon: 'shield' as const },
  { href: '/legal/terms', label: 'Terms of Use', icon: 'scale' as const },
  { href: '/legal/notice', label: 'Legal Notice', icon: 'file' as const },
  { href: SITE.license, label: 'Apache-2.0 License', icon: 'external' as const },
];
---

<footer class="m-footer mt-20 text-sm text-rf-text-muted">
  <div class="m-footer__media" aria-hidden="true">
    <Image
      src={footerDoodles}
      alt=""
      class="m-footer__photo"
      width={768}
      height={432}
      widths={[480, 768]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="m-footer__top-fade" aria-hidden="true"></div>
  <div class="m-footer__scrim" aria-hidden="true"></div>

  <div class="m-footer__content relative z-10 px-6 pb-10">
    <div class="flex items-center gap-3 mb-6">
      <Image
        src={ruforgeLogo}
        alt="RuForge logo"
        width={24}
        height={24}
        widths={[24, 48]}
        class="rounded-md"
        loading="lazy"
      />
      <span class="text-sm font-semibold tracking-tight text-rf-text">RuForge</span>
    </div>
    <p class="text-xs leading-relaxed text-rf-text-muted/90 mb-8 max-w-xs">
      The lightweight, local-first media manager and downloader for Windows. Built with Tauri, Rust, and React.
    </p>

    <div class="space-y-8">
      <div>
        <h3 class="text-[10px] font-semibold tracking-wider text-rf-text uppercase mb-3">Product</h3>
        <ul class="grid grid-cols-2 gap-x-4 gap-y-2.5">
          {productLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="rf-m-link inline-flex items-center gap-1.5 text-rf-text-muted no-underline hover:text-rf-text text-[13px]"
              >
                <Icon name={link.icon} size={13} class="opacity-70" />
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-[10px] font-semibold tracking-wider text-rf-text uppercase mb-3">Community</h3>
        <ul class="grid grid-cols-2 gap-x-4 gap-y-2.5">
          {communityLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="rf-m-link inline-flex items-center gap-1.5 text-rf-text-muted no-underline hover:text-rf-text text-[13px]"
              >
                <Icon name={link.icon} size={13} class="opacity-70" />
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-[10px] font-semibold tracking-wider text-rf-text uppercase mb-3">Legal</h3>
        <ul class="grid grid-cols-2 gap-x-4 gap-y-2.5">
          {legalLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="rf-m-link inline-flex items-center gap-1.5 text-rf-text-muted no-underline hover:text-rf-text text-[13px]"
              >
                <Icon name={link.icon} size={13} class="opacity-70" />
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-5 border-t border-rf-border/20 space-y-3 text-xs text-rf-text-muted/80">
      <p class="leading-relaxed">
        &copy; {new Date().getFullYear()} RuForge. Apache-2.0 licensed. Not affiliated with YouTube or Google.
      </p>
      <div class="flex flex-wrap gap-x-4 gap-y-1">
        <a href="/legal/privacy" class="text-rf-text-muted no-underline hover:text-rf-text">Privacy</a>
        <a href="/legal/terms" class="text-rf-text-muted no-underline hover:text-rf-text">Terms</a>
        <a href="/legal/notice" class="text-rf-text-muted no-underline hover:text-rf-text">Legal</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .m-footer {
    position: relative;
    overflow: hidden;
    border-radius: 2rem 2rem 0 0;
    isolation: isolate;
  }

  .m-footer__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .m-footer__photo,
  .m-footer__photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 38%;
  }

  .m-footer__top-fade {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1;
    height: 5rem;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      var(--color-rf-bg) 0%,
      rgb(29 22 19 / 0.72) 38%,
      transparent 100%
    );
  }

  .m-footer__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgb(29 22 19 / 0.42) 0%,
      rgb(29 22 19 / 0.28) 45%,
      rgb(29 22 19 / 0.38) 100%
    );
  }

  .m-footer__content {
    padding-top: 7rem;
  }
</style>
