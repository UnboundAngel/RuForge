---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { ImageMetadata } from 'astro';

export interface FeatureSection {
  heading: string;
  body: string;
  bullets?: string[];
  image: ImageMetadata;
  imageAlt: string;
}

interface Props {
  title: string;
  description: string;
  sections: FeatureSection[];
}

const { title, description, sections } = Astro.props;
---

<article class="feature-page rf-container">
  <header class="feature-page__hero">
    <nav class="feature-page__breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/features">Features</a></li>
        <li aria-hidden="true">/</li>
        <li class="feature-page__breadcrumb-current">{title}</li>
      </ol>
    </nav>
    <h1 class="feature-page__title">{title}</h1>
    <p class="feature-page__desc">{description}</p>
  </header>

  <div class="feature-page__sections">
    {
      sections.map((section, i) => (
        <section
          class:list={['feature-page__row', i % 2 !== 0 && 'feature-page__row--reverse']}
        >
          <div class="feature-page__copy">
            <h2 class="feature-page__section-heading">{section.heading}</h2>
            <p class="feature-page__section-body">{section.body}</p>
            {section.bullets && section.bullets.length > 0 && (
              <ul class="feature-page__bullets">
                {section.bullets.map((item) => (
                  <li>
                    <span class="feature-page__bullet-arrow" aria-hidden="true">→</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
          <figure class="feature-page__figure">
            <div class="feature-page__frame">
              <Image
                src={section.image}
                alt={section.imageAlt}
                class="feature-page__shot"
                widths={[640, 960, 1280]}
                sizes="(max-width: 768px) 100vw, 56vw"
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </div>
          </figure>
        </section>
      ))
    }
  </div>

  <footer class="feature-page__footer">
    <a href="/features" class="feature-page__back">
      <Icon name="chevron-left" size={16} />
      All features
    </a>
    <a href="/download?start=1" class="rf-btn no-underline">
      <Icon name="download" size={16} class="text-rf-bg" />
      Download RuForge
    </a>
  </footer>
</article>

<style>
  .feature-page {
    padding-bottom: 4rem;
  }

  .feature-page__hero {
    max-width: 38rem;
    margin-bottom: 5rem;
  }

  .feature-page__breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
    font-size: 0.75rem;
    color: var(--color-rf-text-muted);
  }

  .feature-page__breadcrumb a {
    text-decoration: none;
    color: var(--color-rf-text-muted);
    transition: color 0.15s;
  }

  .feature-page__breadcrumb a:hover {
    color: var(--color-rf-text);
  }

  .feature-page__breadcrumb-current {
    color: var(--color-rf-text);
  }

  .feature-page__title {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-rf-text);
  }

  .feature-page__desc {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-rf-text-muted);
    max-width: 34rem;
  }

  .feature-page__sections {
    display: flex;
    flex-direction: column;
    gap: 6rem;
  }

  .feature-page__row {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    column-gap: 4rem;
    align-items: center;
  }

  .feature-page__row--reverse {
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
  }

  .feature-page__row--reverse .feature-page__copy {
    order: 2;
  }

  .feature-page__row--reverse .feature-page__figure {
    order: 1;
  }

  .feature-page__copy {
    max-width: 26rem;
  }

  .feature-page__section-heading {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--color-rf-text);
  }

  .feature-page__section-body {
    margin: 0 0 1.25rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-rf-text-muted);
  }

  .feature-page__bullets {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .feature-page__bullets li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-rf-text);
  }

  .feature-page__bullet-arrow {
    flex-shrink: 0;
    margin-top: 0.08em;
    font-weight: 600;
    color: var(--color-rf-accent);
  }

  .feature-page__figure {
    margin: 0;
    width: 100%;
    min-width: 0;
  }

  .feature-page__frame {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--color-rf-border);
    background: var(--color-rf-surface);
    box-shadow:
      0 4px 20px rgb(0 0 0 / 0.25),
      0 0 0 1px rgb(0 0 0 / 0.1) inset;
  }

  .feature-page__shot,
  .feature-page__shot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .feature-page__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-rf-border);
  }

  .feature-page__back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-rf-text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .feature-page__back:hover {
    color: var(--color-rf-text);
  }

</style>
