---
import { DOWNLOAD_PAGE } from '../lib/site';
---

<a
  href={`${DOWNLOAD_PAGE}?start=1`}
  class="header-download-btn no-underline"
  data-header-download
>
  <span class="header-download-btn__icon" aria-hidden="true">
    <span class="header-download-btn__icon-os" data-os="windows">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="currentColor"
          d="M22 2L11.2 3.6v8l10.8-.1zM10.2 12.5L2 12.4v6.8l8.1 1.1zM2 4.8v6.8h8.1V3.7zm9.1 7.7v7.9L22 22v-9.4z"
        ></path>
      </svg>
    </span>
    <span class="header-download-btn__icon-os" data-os="linux" hidden>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="currentColor"
          d="M12.504 0q-.232 0-.48.021c-4.226.333-3.105 4.807-3.17 6.298c-.076 1.092-.3 1.953-1.05 3.02c-.885 1.051-2.127 2.75-2.716 4.521c-.278.832-.41 1.684-.287 2.489a.4.4 0 0 0-.11.135c-.26.268-.45.6-.663.839c-.199.199-.485.267-.797.4c-.313.136-.658.269-.864.68c-.09.189-.136.394-.132.602c0 .199.027.4.055.536c.058.399.116.728.04.97c-.249.68-.28 1.145-.106 1.484c.174.334.535.47.94.601c.81.2 1.91.135 2.774.6c.926.466 1.866.67 2.616.47c.526-.116.97-.464 1.208-.946c.587-.003 1.23-.269 2.26-.334c.699-.058 1.574.267 2.577.2c.025.134.063.198.114.333l.003.003c.391.778 1.113 1.132 1.884 1.071s1.592-.536 2.257-1.306c.631-.765 1.683-1.084 2.378-1.503c.348-.199.629-.469.649-.853c.023-.4-.2-.811-.714-1.376v-.097l-.003-.003c-.17-.2-.25-.535-.338-.926c-.085-.401-.182-.786-.492-1.046h-.003c-.059-.054-.123-.067-.188-.135a.36.36 0 0 0-.19-.064c.431-1.278.264-2.55-.173-3.694c-.533-1.41-1.465-2.638-2.175-3.483c-.796-1.005-1.576-1.957-1.56-3.368c.026-2.152.236-6.133-3.544-6.139"
        ></path>
      </svg>
    </span>
    <span class="header-download-btn__icon-os" data-os="mac" hidden>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
        <path d="M8 21h8M12 17v4" stroke-linecap="round"></path>
      </svg>
    </span>
  </span>
  <span class="header-download-btn__text">Download</span>
</a>

<script>
  type HeaderOs = 'windows' | 'linux' | 'mac';

  function detectHeaderOs(): HeaderOs {
    const ua = navigator.userAgent.toLowerCase();
    const platform = (navigator.userAgentData?.platform || navigator.platform || '').toLowerCase();
    if (platform.includes('linux') || ua.includes('linux')) return 'linux';
    if (platform.includes('mac') || ua.includes('mac')) return 'mac';
    return 'windows';
  }

  function applyHeaderDownloadIcons() {
    const os = detectHeaderOs();
    document.querySelectorAll('[data-header-download]').forEach((btn) => {
      btn.querySelectorAll('[data-os]').forEach((el) => {
        const node = el as HTMLElement;
        node.hidden = node.getAttribute('data-os') !== os;
      });
    });
  }

  applyHeaderDownloadIcons();
  document.addEventListener('astro:page-load', applyHeaderDownloadIcons);
</script>

<style>
  .header-download-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: auto;
    height: auto;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    background: var(--color-rf-accent);
    color: var(--color-rf-bg);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.28);
    transition:
      filter 0.2s ease,
      box-shadow 0.2s ease;
  }

  .header-download-btn:hover {
    filter: brightness(1.06);
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.32);
  }

  .header-download-btn__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.125rem;
    height: 1.125rem;
  }

  .header-download-btn__icon-os {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .header-download-btn__icon-os[hidden] {
    display: none;
  }

  .header-download-btn__text {
    display: inline;
    margin-left: 0.5rem;
  }
</style>
