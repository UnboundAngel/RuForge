---
import { releaseAreaIcon } from '../lib/releaseAreaIcons';
import { splitReleaseNote } from '../lib/releaseNotes';

interface Props {
  kind: 'add' | 'fix';
  items: string[];
  compact?: boolean;
}

const { kind, items, compact = false } = Astro.props;
const lines = items.map(splitReleaseNote);
---

<section class="space-y-4">
  <h3 class:list={['release-group__label', kind === 'add' ? 'text-rf-add' : 'text-rf-fix']}>
    {kind === 'add' ? 'added' : 'fixed'}
    <span class="release-group__count">{items.length}</span>
  </h3>
  <ul class:list={['release-grid', compact && 'release-grid--compact']}>
    {
      lines.map((line) => {
        const Icon = line.area ? releaseAreaIcon(line.area) : null;
        return (
          <li class:list={['release-card', line.group ? `rf-roadmap-ready--${line.group.toLowerCase()}` : 'release-card--plain']}>
            {Icon && (
              <span class="release-card__area">
                <Icon size={12} strokeWidth={2.4} aria-hidden="true" />
                {line.area}
              </span>
            )}
            <span class="release-card__text">{line.text}</span>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .release-group__label {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.625rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .release-group__count {
    color: rgb(201 184 122 / 0.45);
  }

  .release-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .release-grid--compact {
    grid-template-columns: minmax(0, 1fr);
  }

  .release-card--plain {
    --rf-chip: #c9b87a;
  }

  .release-card {
    display: flex;
    flex-direction: column;
    border-radius: 14px;
    background: #2b211c;
    overflow: hidden;
  }

  .release-card__area {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.625rem 1.125rem;
    background: color-mix(in srgb, var(--rf-chip) 15%, #2b211c);
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--rf-chip);
  }

  .release-card__text {
    padding: 1rem 1.125rem;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-rf-text);
  }

  .release-card__area + .release-card__text {
    padding-top: 0.75rem;
  }

  @media (max-width: 767px) {
    .release-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
