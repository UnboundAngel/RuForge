---
import type { IconName } from '../lib/icons';
import Icon from './Icon.astro';

interface Props {
  title: string;
  description?: string;
  icon?: IconName;
}

const { title, description, icon } = Astro.props;
---

<header class="space-y-4 pb-4">
  <div class="flex items-center gap-3">
    {icon && (
      <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-rf-surface text-rf-accent">
        <Icon name={icon} size={22} />
      </span>
    )}
    <h1 class="text-3xl font-semibold text-rf-text">{title}</h1>
  </div>
  {description && <p class="max-w-2xl text-base leading-relaxed text-rf-text-muted">{description}</p>}
  <slot />
</header>
