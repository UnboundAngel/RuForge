---
import { Image } from 'astro:assets';
import ruforgeLogo from '../assets/ruforge-logo.png';

interface Props {
  size?: number;
  showWordmark?: boolean;
  class?: string;
}

const { size = 36, showWordmark = true, class: className = '' } = Astro.props;
---

<a href="/" class:list={['inline-flex items-center gap-3 no-underline', className]} aria-label="RuForge Home">
  <Image
    src={ruforgeLogo}
    alt="RuForge logo"
    width={size}
    height={size}
    widths={[size, size * 2]}
    class="rounded-md"
    loading="eager"
  />
  {showWordmark && <span class="text-xl font-semibold tracking-tight text-rf-text">RuForge</span>}
</a>
