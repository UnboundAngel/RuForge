---
import { DOCS_TREE } from '../lib/docsTree';
import DocsSearch from './DocsSearch';

interface Props {
  activeSlug?: string;
}

const { activeSlug } = Astro.props;

function isActive(slug: string) {
  return slug === activeSlug;
}

function sectionHasActive(sectionId: string) {
  const section = DOCS_TREE.find((s) => s.id === sectionId);
  if (!section) return false;
  return section.pages.some((p) => p.slug === activeSlug);
}
---

<aside class="docs-sidebar" aria-label="Documentation navigation">
  <div class="docs-sidebar__header">
    <a href="/docs" class="docs-sidebar__brand">
      <span class="docs-sidebar__brand-name">RuForge</span>{' '}
      <span class="docs-sidebar__brand-label">Docs</span>
    </a>
  </div>

  <DocsSearch client:idle />

  <nav class="docs-sidebar__tree">
    {DOCS_TREE.map((section) => {
      const hasActive = sectionHasActive(section.id);
      const isOpen = section.defaultOpen || hasActive;
      return (
        <details class="docs-sidebar__section" open={isOpen}>
          <summary class="docs-sidebar__section-label">
            <svg class="docs-sidebar__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="m9 18 6-6-6-6" />
            </svg>
            {section.label}
          </summary>
          <ul class="docs-sidebar__pages">
            {section.pages.map((page) => (
              <li class:list={[
                'docs-sidebar__page-item',
                isActive(page.slug) && 'docs-sidebar__page-item--active',
              ]}>
                {page.externalHref ? (
                  <a
                    href={page.externalHref}
                    class="docs-sidebar__link"
                    target={page.externalHref.startsWith('http') ? '_blank' : undefined}
                    rel={page.externalHref.startsWith('http') ? 'noopener noreferrer' : undefined}
                  >
                    {page.title}
                  </a>
                ) : (
                  <a
                    href={`/docs/${page.slug}`}
                    class:list={[
                      'docs-sidebar__link',
                      isActive(page.slug) && 'docs-sidebar__link--active',
                    ]}
                    aria-current={isActive(page.slug) ? 'page' : undefined}
                  >
                    {page.title}
                  </a>
                )}
              </li>
            ))}
          </ul>
        </details>
      );
    })}
  </nav>
</aside>

<style>
  .docs-sidebar {
    position: sticky;
    top: 5rem;
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 16rem;
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
    flex-shrink: 0;
    padding-bottom: 3rem;
    scrollbar-width: thin;
    scrollbar-color: rgb(237 215 156 / 0.12) transparent;
  }

  .docs-sidebar::-webkit-scrollbar {
    width: 5px;
  }

  .docs-sidebar::-webkit-scrollbar-track {
    background: transparent;
  }

  .docs-sidebar::-webkit-scrollbar-thumb {
    background: rgb(237 215 156 / 0.12);
    border-radius: 9999px;
  }

  .docs-sidebar__header {
    padding: 0 0 1rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid rgb(237 215 156 / 0.08);
  }

  .docs-sidebar__brand {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
    text-decoration: none;
    color: var(--color-rf-text);
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .docs-sidebar__brand:hover {
    opacity: 1;
  }

  .docs-sidebar__brand-name {
    color: var(--color-rf-text);
  }

  .docs-sidebar__brand-label {
    color: var(--color-rf-text-muted);
    font-weight: 400;
  }

  .docs-sidebar__search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid rgb(237 215 156 / 0.1);
    background: rgb(29 22 19 / 0.5);
    margin-bottom: 1.25rem;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }

  .docs-sidebar__search:hover {
    border-color: rgb(237 215 156 / 0.2);
  }

  .docs-sidebar__search-icon {
    flex-shrink: 0;
    color: var(--color-rf-text-muted);
    opacity: 0.5;
  }

  .docs-sidebar__search-placeholder {
    font-size: 0.8125rem;
    color: var(--color-rf-text-muted);
    opacity: 0.45;
  }

  .docs-sidebar__tree {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .docs-sidebar__section {
    margin: 0;
  }

  .docs-sidebar__section > summary {
    list-style: none;
  }

  .docs-sidebar__section > summary::-webkit-details-marker {
    display: none;
  }

  .docs-sidebar__section-label {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.4rem 0.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-rf-text);
    cursor: pointer;
    user-select: none;
    border-radius: 0.375rem;
    transition: background 0.12s ease;
  }

  .docs-sidebar__section-label:hover {
    background: rgb(237 215 156 / 0.04);
  }

  .docs-sidebar__chevron {
    flex-shrink: 0;
    color: var(--color-rf-text-muted);
    opacity: 0.5;
    transition: transform 0.15s ease;
  }

  .docs-sidebar__section[open] > .docs-sidebar__section-label > .docs-sidebar__chevron {
    transform: rotate(90deg);
  }

  /* Child page list with left tree line */
  .docs-sidebar__pages {
    list-style: none;
    margin: 0;
    padding: 0.125rem 0 0.375rem 0;
    margin-left: 0.6875rem;
    border-left: 1.5px solid rgb(237 215 156 / 0.1);
  }

  /* Each child item positions relative so the active line segment can overlay */
  .docs-sidebar__page-item {
    position: relative;
  }

  /* Active item: paint the tree line segment in accent color */
  .docs-sidebar__page-item--active::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 0;
    bottom: 0;
    width: 1.5px;
    background: var(--color-rf-accent);
    border-radius: 1px;
  }

  .docs-sidebar__link {
    display: block;
    padding: 0.3rem 0.5rem 0.3rem 1rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-rf-text-muted);
    text-decoration: none;
    border-radius: 0.375rem;
    transition:
      color 0.12s ease,
      background 0.12s ease;
  }

  .docs-sidebar__link:hover {
    color: var(--color-rf-text);
    background: rgb(237 215 156 / 0.04);
    opacity: 1;
  }

  .docs-sidebar__link--active {
    color: var(--color-rf-accent);
    background: rgb(237 215 156 / 0.06);
  }

  .docs-sidebar__link--active:hover {
    color: var(--color-rf-accent);
    background: rgb(237 215 156 / 0.1);
  }
</style>
