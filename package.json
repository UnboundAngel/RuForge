{
  "name": "ruforge",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:app": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-app.ps1",
    "dev:disk": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-disk-report.ps1",
    "dev:clean:safe": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-clean-safe.ps1",
    "dev:rust-recover": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-rust-recover.ps1",
    "companion:build": "vite build --config companion-web.config.ts",
    "companion:dev": "vite build --config companion-web.config.ts --watch",
    "build": "npm run companion:build && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:signed": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-signed-windows.ps1",
    "prep:website-release": "node scripts/sync-website-release.mjs",
    "prep:website-release:changelog-only": "node scripts/sync-website-release.mjs --skip-installer --skip-build",
    "shipped": "node scripts/shipped.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@aptabase/tauri": "https://github.com/aptabase/tauri-plugin-aptabase.git#1.0.0",
    "@iconify/react": "^6.0.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.3.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-store": "^2.1.2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.475.0",
    "markdown-to-jsx": "^9.8.0",
    "motion": "^12.38.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@iconify-json/line-md": "^1.2.16",
    "@iconify-json/material-symbols": "^1.2.75",
    "@iconify-json/mynaui": "^1.2.17",
    "@iconify-json/tabler": "^1.2.35",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
